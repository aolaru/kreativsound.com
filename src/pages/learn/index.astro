---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Guides Have Moved | Kreativ Sound"
  description="Kreativ Sound practical guides now live alongside release notes and remain available through site search."
  canonical="https://kreativsound.com/updates/"
  robots="noindex,follow"
  activeNav="updates"
>
  <section class="card page-main legacy-guides-page">
    <p class="eyebrow">Guides</p>
    <h1 class="page-title">Practical guides now live with Updates.</h1>
    <p class="page-lead">The separate Learn section has been retired. Product workflows and sound-design articles remain available alongside Updates and through site search.</p>
    <div class="legacy-guides-actions">
      <a class="button primary" href="/updates/#guides">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        Browse practical guides
      </a>
      <a class="button secondary" href="/search/?q=guide">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        Search guides
      </a>
    </div>
  </section>
</BaseLayout>
