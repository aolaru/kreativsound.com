---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About | Kreativ Sound"
  description="About Kreativ Sound, an independent sound-design project creating atmospheric presets, sample packs, browser tools, and dark cinematic textures."
  canonical="https://kreativsound.com/about/"
  activeNav="about"
>
  <section class="card page-main brand-page">
    <div class="brand-hero">
      <div class="brand-hero-copy">
        <p class="eyebrow">About</p>
        <h1 class="page-title">Sound design for darker electronic and cinematic work.</h1>
        <p class="page-lead">Kreativ Sound is Andrei Olaru's independent catalog of preset banks, sample packs, browser tools, and instruments.</p>
        <div class="brand-hero-actions">
          <a class="button primary" href="/sounds/">Browse Sounds <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <a class="button secondary" href="/plugins/">Explore Plugins <i class="fa-solid fa-plug" aria-hidden="true"></i></a>
        </div>
      </div>
      <div class="brand-hero-panel">
        <p class="product-section-kicker">Made by Andrei Olaru</p>
        <h2>Built from real creative work.</h2>
        <p>Every release begins with a practical role: establish atmosphere, introduce movement, or add tension without slowing a session down.</p>
        <a class="brand-artist-link" href="/music/">Hear the Olaru project <i class="fa-solid fa-headphones" aria-hidden="true"></i></a>
      </div>
    </div>

    <section class="brand-plugin-feature" aria-labelledby="brand-plugins-title">
      <a class="brand-plugin-art" href="/plugins/ghostform" aria-label="Explore KS Ghostform">
        <img src="/assets/thumbs/ghostform-interface.png" width="1005" height="649" alt="KS Ghostform synthesizer interface showing the Voltage Sleep preset" loading="lazy" decoding="async" />
      </a>
      <div class="brand-plugin-copy">
        <p class="product-section-kicker">New: Kreativ Sound Plugins</p>
        <h2 id="brand-plugins-title">A new space for instruments.</h2>
        <p>Plugins are now part of Kreativ Sound. KS Ghostform is a free evolving drone and string synth for cinematic beds, deep drones, and ambient texture.</p>
        <div class="brand-plugin-facts" aria-label="KS Ghostform facts">
          <span>Free plugin</span>
          <span>144 factory presets</span>
          <span>macOS AU/VST3 · Windows VST3</span>
        </div>
        <div class="brand-plugin-actions">
          <a class="button primary" href="/plugins/">Explore Plugins <i class="fa-solid fa-plug" aria-hidden="true"></i></a>
          <a class="button secondary" href="/plugins/ghostform">See KS Ghostform <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="brand-start" aria-labelledby="brand-start-title">
      <div class="brand-start-head">
        <p class="product-section-kicker">Explore Kreativ Sound</p>
        <h2 id="brand-start-title">Start with what you need.</h2>
      </div>
      <div class="brand-start-grid">
        <a href="/sounds/">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          <span><strong>Sounds</strong><small>Preset banks and sample packs for atmosphere, motion, and texture.</small></span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href="/tools/">
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
          <span><strong>Tools</strong><small>Free browser tools for generating, shaping, and preparing material.</small></span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href="/music/">
          <i class="fa-solid fa-headphones" aria-hidden="true"></i>
          <span><strong>Music</strong><small>Hear the Olaru releases that put the same palette into context.</small></span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </section>
</BaseLayout>
