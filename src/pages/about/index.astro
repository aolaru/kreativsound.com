---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About | Kreativ Sound"
  description="Independent sound design by Andrei Olaru: atmospheric preset banks, sample packs, free and Pro browser tools, and instruments for darker music."
  canonical="https://kreativsound.com/about/"
  activeNav="about"
>
  <section class="card page-main brand-page about-concise" aria-labelledby="about-title">
    <header class="about-intro">
      <p class="eyebrow">About</p>
      <h1 id="about-title" class="page-title">Independent sound design by Andrei Olaru.</h1>
      <p class="page-lead">I'm Andrei, the creator of Kreativ Sound. I make preset banks, sample packs, browser tools, and instruments for dark electronic, ambient, and cinematic music.</p>
      <p class="about-note">My focus is atmosphere, movement, and texture: sounds that work as starting points, not finished answers. The same palette runs through my music as Olaru.</p>
    </header>

    <section class="about-instruments" aria-labelledby="about-instruments-title">
      <a class="about-synth-image" href="/plugins/ghostform" aria-label="See KS Ghostform product details">
        <img src="/assets/thumbs/ghostform-interface.png" width="1005" height="649" alt="KS Ghostform synthesizer interface showing the Voltage Sleep preset" loading="lazy" decoding="async" />
      </a>
      <div>
        <h2 id="about-instruments-title">Sounds, tools, and instruments.</h2>
        <p class="about-note">Alongside sound packs, I develop free and Pro browser tools and plugins. KS Ghostform is my free drone and string synthesizer for evolving ambient textures.</p>
      </div>
    </section>

    <nav class="about-explore" aria-label="Explore Kreativ Sound">
      <a class="button secondary" href="/plugins/">Plugins</a>
      <a class="button secondary" href="/sounds/">Sounds</a>
      <a class="button secondary" href="/tools/">Tools</a>
      <a class="button secondary" href="/music/">Music</a>
    </nav>

    <p class="about-purchases">Purchases and downloads are handled through Gumroad. For installation, licensing, or purchase questions, <a href="/contact/">contact Support</a>.</p>
  </section>
</BaseLayout>

<style>
  .about-concise {
    max-width: 840px;
    gap: 1.75rem;
  }

  .about-intro .page-title {
    max-width: 23ch;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
  }

  .about-intro .page-lead,
  .about-note {
    max-width: 65ch;
    margin-bottom: 0;
  }

  .about-note {
    color: var(--muted);
  }

  .about-intro > .about-note {
    margin-top: 0.8rem;
  }

  .about-instruments {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 1.5rem;
  }

  .about-instruments h2 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
  }

  .about-instruments p {
    margin: 0;
  }

  .about-synth-image {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: #15131a;
  }

  .about-synth-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .about-purchases {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--card-border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .about-instruments {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .about-explore {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-explore .button {
      justify-content: center;
    }
  }
</style>
