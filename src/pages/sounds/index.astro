---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SoundLanding from "../../components/SoundLanding.astro";
---
<BaseLayout
  title="Dark Ambient Presets, Samples & FX | Kreativ Sound"
  description="Dark ambient synth presets, cinematic sample packs, sound effects, free Lite banks, and archive releases for JUN-6 V, Pigments, FM8, Vital, and more."
  canonical="https://kreativsound.com/sounds/"
  activeNav="sound"
  bodyClass="home-page"
  skipLinkTarget="#catalog-title"
  skipLinkLabel="Skip to product catalog"
>
  <SoundLanding
    intro="The complete Kreativ Sound catalog: bundles, presets, sample packs, free Lite banks, and archive releases."
    showGuide={true}
    showFeatured={false}
    showHeroActions={false}
    showProof={false}
    visibleCategories={["Bundle", "Presets", "Samples", "Free", "Legacy"]}
  />
</BaseLayout>
