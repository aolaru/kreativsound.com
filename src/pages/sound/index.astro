---
const target = "/sounds/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sound moved to Sounds | Kreativ Sound</title>
    <meta name="description" content="The old Sound page has moved to the Kreativ Sound catalog." />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://kreativsound.com/sounds/" />
    <script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </head>
  <body>
    <main>
      <h1>Sound moved to Sounds</h1>
      <p>Redirecting to <a href={target}>the Kreativ Sound catalog</a>.</p>
    </main>
  </body>
</html>
