---
import { productPages } from "../../lib/product-pages";

export function getStaticPaths() {
  return productPages.map((product) => ({
    params: { slug: product.slug },
    props: { target: `/sounds/${product.slug}`, title: product.headline }
  }));
}

const { target, title } = Astro.props;
const canonical = `https://kreativsound.com${target}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to {title} | Kreativ Sound</title>
    <meta name="description" content={`The old product page for ${title} has moved to its canonical Kreativ Sound product page.`} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </head>
  <body>
    <main>
      <h1>Product page moved</h1>
      <p>Redirecting to <a href={target}>{title}</a>.</p>
    </main>
  </body>
</html>
