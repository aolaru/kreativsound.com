---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../lib/products";
import { productPages } from "../../lib/product-pages";
import toolReleases from "../../data/tool-releases.json";

const catalogGroups = [
  { label: "Plugins", category: "Tools", plugin: true },
  { label: "Bundles", category: "Bundle" },
  { label: "Preset packs", category: "Presets" },
  { label: "Sample packs", category: "Samples" },
  { label: "Free packs", category: "Free" },
  { label: "Legacy archive", category: "Legacy" }
].map(({ label, category, plugin }) => ({
  label,
  entries: products
    .filter((product) => product.category === category && product.status !== "comingSoon"
      && (!plugin || product.detailsUrl?.startsWith("/plugins/")))
    .map((product) => {
      const page = productPages.find((page) => page.route === product.detailsUrl);
      return {
        name: page?.headline || product.title,
        helpUrl: page ? `${page.route}${page.installation ? "#product-installation-title" : "#product-final-cta-title"}` : "/sounds/",
        helpLabel: page?.installation ? "Installation help" : "Product details and downloads"
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name))
})).filter((group) => group.entries.length);

const toolHelp = {
  presetMutatorFree: { helpUrl: "/tools/preset-mutator/#preset-mutator-formats-title", helpLabel: "Supported formats and export details" },
  presetMutatorPro: { helpUrl: "/tools/preset-mutator/#preset-mutator-activation-title", helpLabel: "Pro activation help" },
  waveMutator: { helpUrl: "/posts/how-to-finish-a-sample-pack-with-wave-mutator-2026-09-03.html", helpLabel: "WAV preparation and export guide" },
  patternMutator: { helpUrl: "/tools/pattern-mutator/", helpLabel: "MIDI workflow and export help" }
};

catalogGroups.splice(1, 0, {
  label: "Browser tools",
  entries: Object.entries(toolReleases).map(([key, release]) => ({
    name: release.name,
    ...(toolHelp[key as keyof typeof toolHelp] || { helpUrl: release.changelog, helpLabel: "Release notes" })
  })).sort((a, b) => a.name.localeCompare(b.name))
});
---
<BaseLayout
  title="Support | Kreativ Sound"
  description="Get help with a Kreativ Sound product or purchase. Find installation help or send Andrei a message."
  canonical="https://kreativsound.com/contact/"
  activeNav="contact"
>
  <section class="card page-main contact-page-modern contact-simple" aria-labelledby="contact-title">
    <header>
      <p class="eyebrow">Kreativ Sound</p>
      <h1 id="contact-title" class="page-title">Support</h1>
      <p class="page-lead">Get help with a product or purchase.</p>
    </header>

    <form class="contact-form" action="https://formsubmit.co/info@kreativsound.com" method="POST" aria-label="Contact Andrei" aria-describedby="contact-privacy">
      <input type="hidden" name="_subject" value="Kreativ Sound — contact enquiry" />
      <input type="hidden" name="_template" value="table" />
      <input class="contact-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="contact-field-row">
        <div class="contact-field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required />
        </div>
        <div class="contact-field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
      </div>

      <div class="contact-field">
        <label for="contact-product">Product or enquiry</label>
        <select id="contact-product" name="product" required>
          <option value="" selected disabled>Select a product or general enquiry</option>
          <option value="General enquiry">General enquiry / collaboration</option>
          <option value="Other product">Other / not listed</option>
          {catalogGroups.map((group) => (
            <optgroup label={group.label}>
              {group.entries.map((entry) => <option value={entry.name} data-help-url={entry.helpUrl} data-help-label={entry.helpLabel}>{entry.name}</option>)}
            </optgroup>
          ))}
        </select>
        <p id="contact-product-help" class="contact-form-note" aria-live="polite" hidden>
          <a href="/sounds/" target="_blank" rel="noopener noreferrer"></a>
          <span> (opens in a new tab)</span>
        </p>
      </div>

      <div class="contact-field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="5" maxlength="5000" placeholder="How can I help? For support, describe what happened and what you expected." required></textarea>
      </div>

      <div class="contact-field-row">
        <div class="contact-field">
          <label for="contact-version">Product version <span>(optional)</span></label>
          <input id="contact-version" name="product_version" type="text" maxlength="100" placeholder="e.g. Ghostform 1.0.0" />
        </div>
        <div class="contact-field">
          <label for="contact-system">OS / DAW / browser <span>(optional)</span></label>
          <input id="contact-system" name="system" type="text" maxlength="200" placeholder="e.g. macOS 15, Ableton Live 12" />
        </div>
      </div>

      <p id="contact-privacy" class="contact-form-note">Sent through FormSubmit, with a spam check before delivery. <a href="/privacy/">Privacy details</a>.</p>
      <button class="button primary" type="submit">Send message</button>
    </form>

    <p class="contact-direct">Prefer email? <a href="mailto:info@kreativsound.com">info@kreativsound.com</a></p>
  </section>
</BaseLayout>

<script>
  const productSelect = document.querySelector<HTMLSelectElement>("#contact-product");
  const productHelp = document.querySelector<HTMLParagraphElement>("#contact-product-help");
  const helpLink = productHelp?.querySelector<HTMLAnchorElement>("a");

  function updateProductHelp() {
    if (!productSelect || !productHelp || !helpLink) return;
    const option = productSelect.selectedOptions[0];
    const url = option?.dataset.helpUrl;
    const label = option?.dataset.helpLabel;
    productHelp.hidden = !url || !label;
    if (url && label) {
      helpLink.href = url;
      helpLink.textContent = label;
    } else {
      helpLink.removeAttribute("href");
      helpLink.textContent = "";
    }
  }

  productSelect?.addEventListener("change", updateProductHelp);
  window.addEventListener("pageshow", updateProductHelp);
  updateProductHelp();
</script>

<style>
  .contact-simple {
    max-width: 680px;
    gap: 1.5rem;
  }

  .contact-simple .page-lead {
    max-width: 45ch;
    margin-bottom: 0;
  }

  .contact-form,
  .contact-field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .contact-form {
    gap: 1rem;
  }

  .contact-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-field label {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .contact-field label span {
    color: var(--muted);
    font-weight: 400;
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 46px;
    padding: 0.75rem;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    color-scheme: light;
  }

  :global([data-theme="dark"]) .contact-field input,
  :global([data-theme="dark"]) .contact-field select,
  :global([data-theme="dark"]) .contact-field textarea {
    color-scheme: dark;
  }

  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .contact-field textarea {
    resize: vertical;
  }

  .contact-field input:focus-visible,
  .contact-field select:focus-visible,
  .contact-field textarea:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .contact-form .button {
    justify-self: start;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .contact-honey {
    display: none;
  }

  .contact-form-note,
  .contact-direct {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .contact-field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
