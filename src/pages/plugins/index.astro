---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Plugins | Kreativ Sound"
  description="Kreativ Sound instruments and effects for atmospheric, cinematic, and textural work. KS Ghostform is available now as a free drone and string synthesizer."
  canonical="https://kreativsound.com/plugins/"
  activeNav="plugins"
>
  <section class="card page-main plugins-page" aria-labelledby="plugins-title">
    <header class="plugins-intro">
      <p class="eyebrow">New free plugin</p>
      <h1 id="plugins-title" class="page-title">KS Ghostform</h1>
      <p class="page-lead">An evolving drone and string synth for cinematic beds, deep drones, and textured ambient work.</p>
    </header>

    <article class="plugins-release-card" aria-label="KS Ghostform release">
      <a class="plugins-release-art" href="/plugins/ghostform" aria-label="View KS Ghostform details">
        <img src="/assets/thumbs/ghostform-interface.png" width="1005" height="649" alt="KS Ghostform synthesizer interface showing the Voltage Sleep preset" loading="eager" decoding="async" fetchpriority="high" />
      </a>
      <div class="plugins-release-copy">
        <dl class="plugins-release-meta" aria-label="KS Ghostform facts">
          <div><dt>Presets</dt><dd>144 factory sounds</dd></div>
          <div><dt>Formats</dt><dd>macOS AU/VST3 · Windows VST3</dd></div>
          <div><dt>Access</dt><dd>Free · no activation</dd></div>
        </dl>
        <div class="product-actions">
          <a class="button primary" data-track="generate_lead" data-track-product="ghostform" data-track-placement="plugins_feature" href="https://kreativ.gumroad.com/l/ks-ghostform" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-download" aria-hidden="true"></i>
            Download Free
          </a>
          <a class="button secondary" href="/plugins/ghostform">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            Product Details
          </a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
