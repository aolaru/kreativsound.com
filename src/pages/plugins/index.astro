---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Plugins | Kreativ Sound"
  description="Kreativ Sound instrument and effect plugins are in development, with product pages, demos, and release notes coming soon."
  canonical="https://kreativsound.com/plugins/"
  activeNav="plugins"
>
  <section class="card page-main plugins-page" aria-labelledby="plugins-title">
    <p class="eyebrow">Plugins</p>
    <h1 id="plugins-title" class="page-title">Kreativ Sound plugins are coming soon.</h1>
    <p class="page-lead">Instrument and effect releases are now in development. Product pages, format details, demos, and release notes will appear here as each plugin becomes available.</p>
    <div class="plugins-page-status" aria-label="Plugin release status">
      <span>Coming soon</span>
      <p>New releases will be announced through Kreativ Sound News.</p>
    </div>
    <div class="plugins-page-actions">
      <a class="button primary" href="/news/">
        <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
        View News
      </a>
      <a class="button secondary" href="/sounds/">
        <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
        Browse Sounds
      </a>
    </div>
  </section>
</BaseLayout>
