---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PresetMutatorDetails from "../../../components/PresetMutatorDetails.astro";

const appUrl = "/preset-mutator/";
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Preset Mutator Free",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Web browser",
  description: "Preset Mutator Free creates Vital, Serum 2, and Arturia Pigments preset starting points from scratch ideas, existing presets, or short audio sources.",
  url: "https://kreativsound.com/tools/preset-mutator/",
  image: "https://kreativsound.com/preset-mutator/preset-mutator-mark.svg",
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "0",
    highPrice: "19",
    priceCurrency: "EUR",
    offerCount: 2,
    availability: "https://schema.org/InStock"
  },
  creator: {
    "@type": "Person",
    name: "Andrei Olaru"
  }
};
---
<BaseLayout
  title="Preset Mutator Free | Kreativ Sound"
  description="Preset Mutator Free creates Vital, Serum 2, and Arturia Pigments preset starts from scratch ideas, existing presets, or short audio sources."
  canonical="https://kreativsound.com/tools/preset-mutator/"
  activeNav="tools"
  ogImage="https://kreativsound.com/preset-mutator/preset-mutator-mark.svg"
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <article class="card page-main product-page product-page-modern tools-page preset-mutator-sales-page">
    <section class="product-hero preset-mutator-sales-hero">
      <div class="product-hero-copy">
        <p class="product-kicker">Browser tool</p>
        <h1 class="page-title">Preset Mutator Free</h1>
        <p class="page-lead">Create Vital, Serum 2, or Arturia Pigments preset starts from scratch, from one preset, or from one short audio source.</p>
        <p class="product-summary">Preset Mutator Free is a local-first browser tool for quick synth sketches: playable starts you can finish inside Vital, Serum 2, or Pigments.</p>
        <div class="product-specs-inline" aria-label="Preset Mutator Free summary">
          <div class="product-spec-inline">
            <span class="product-spec-label">Live now</span>
            <span class="product-spec-value">Vital export</span>
          </div>
          <div class="product-spec-inline">
            <span class="product-spec-label">Access</span>
            <span class="product-spec-value">Free + Pro</span>
          </div>
          <div class="product-spec-inline">
            <span class="product-spec-label">Beta formats</span>
            <span class="product-spec-value">Free + Pro: Serum 2 + Pigments</span>
          </div>
        </div>
        <p class="product-trust-line">Runs locally in your browser. No AI preset generation. No uploads or stored presets/audio.</p>
      </div>

      <div class="product-hero-media preset-mutator-sales-card">
        <div class="preset-mutator-mark-frame">
          <img src="/preset-mutator/preset-mutator-mark.svg" width="220" height="220" alt="Preset Mutator Free mark" />
        </div>
        <div class="product-media-actions">
          <a class="button primary" href={appUrl}>
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
            Open Preset Mutator Free
          </a>
          <a class="button secondary" href="/preset-mutator-pro/">
            <i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i>
            Open Preset Mutator Pro
          </a>
          <a class="button secondary" href="https://kreativ.gumroad.com/l/preset-mutator" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
            Get Pro for €19
          </a>
        </div>
        <p class="product-value-line">Free creates 3 individual presets. Pro creates 32-variant ZIP packs for Vital, Serum 2 beta, and Pigments beta.</p>
      </div>
    </section>

    <section class="product-proof-strip preset-mutator-proof" aria-label="Preset Mutator Free trust points">
      <article>
        <i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
        <p>Processing happens in the browser, so source material does not need to be uploaded.</p>
      </article>
      <article>
        <i class="fa-solid fa-ban" aria-hidden="true"></i>
        <p>No AI generation: presets are built from local rules and curated seed data.</p>
      </article>
      <article>
        <i class="fa-solid fa-download" aria-hidden="true"></i>
        <p>The free tool exports three individual presets per run; Pro expands the workflow into a 32-variant ZIP pack.</p>
      </article>
    </section>

    <section class="product-story-grid preset-mutator-mode-grid">
      <article class="product-panel product-panel-modern product-panel-accent">
        <p class="product-section-kicker">Default</p>
        <h2>From Scratch</h2>
        <p>Choose intent, mood, register, and shape controls to generate a quick playable idea without a source file.</p>
      </article>
      <article class="product-panel product-panel-modern">
        <p class="product-section-kicker">Preset source</p>
        <h2>Mutate Preset</h2>
        <p>Load one `.vital`, `.SerumPreset`, or Pigments `.pgtx` file and create related variations while keeping the original identity close enough to refine.</p>
      </article>
      <article class="product-panel product-panel-modern">
        <p class="product-section-kicker">Audio source</p>
        <h2>Audio to Preset</h2>
        <p>Analyze one short sound locally and turn it into Vital, Serum 2, or Pigments preset directions. Best for simple tones, textures, drones, and focused one-shots.</p>
      </article>
      <article class="product-panel product-panel-modern product-panel-accent">
        <p class="product-section-kicker">Formats</p>
        <h2>Vital stable, two formats in beta</h2>
        <p>Vital export is stable. Serum 2 and Arturia Pigments generation are available as beta targets.</p>
      </article>
    </section>

    <section class="preset-mutator-compare" aria-labelledby="preset-mutator-compare-title">
      <div>
        <p class="product-section-kicker">Tool scope</p>
        <h2 id="preset-mutator-compare-title">Choose a quick free start or a larger Pro pack.</h2>
      </div>
      <div class="preset-mutator-compare-grid">
        <article>
          <h3>Free</h3>
          <ul>
            <li>3 preset variants per workflow for Vital, Serum 2 beta, and Pigments beta.</li>
            <li>Manual download of generated presets.</li>
            <li>Local browser processing and no account requirement.</li>
          </ul>
        </article>
        <article>
          <h3>Pro</h3>
          <ul>
            <li>32 preset variants per workflow for Vital, Serum 2 beta, and Pigments beta.</li>
            <li>Full 32-preset ZIP export.</li>
            <li>One-time €19 purchase; activate with your Gumroad license key.</li>
          </ul>
        </article>
      </div>
    </section>

    <PresetMutatorDetails />

    <section class="product-cta-strip">
      <div class="product-cta-copy">
        <p class="product-section-kicker">Release focus</p>
        <p class="product-cta-line">Start free for three variants, or use Pro for a 32-preset Vital, Serum 2 beta, or Pigments beta pack.</p>
      </div>
      <div class="product-actions">
        <a class="button primary" href={appUrl}>
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
          Open Preset Mutator Free
        </a>
        <a class="button secondary" href="/preset-mutator-pro/">
          <i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i>
          Open Preset Mutator Pro
        </a>
        <a class="button secondary" href="https://kreativ.gumroad.com/l/preset-mutator" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          Get Pro for €19
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
