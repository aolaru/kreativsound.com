---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Tools | Kreativ Sound"
  description="Kreativ Sound browser tools for local-first preset generation and audio wave preparation."
  canonical="https://kreativsound.com/tools/"
  activeNav="tools"
>
  <section class="card page-main product-page tools-page">
    <div class="stack">
      <section class="tools-feature-card" aria-labelledby="tools-title">
        <div class="tools-feature-copy">
          <p class="product-kicker">Current tool</p>
          <h1 id="tools-title" class="page-title">Preset Mutator Lite</h1>
          <p class="page-lead">Create Vital preset starts from scratch ideas, existing presets, or one short audio source.</p>
          <p class="product-summary">Start with the Lite local-first Vital workflow for three variants and individual downloads. Preset Mutator PRO expands the same three modes into a 32-variant ZIP pack.</p>
          <dl class="tools-feature-meta" aria-label="Preset Mutator Lite facts">
            <div>
              <dt>Format</dt>
              <dd>Browser tool</dd>
            </div>
            <div>
              <dt>Synth</dt>
              <dd>Vital</dd>
            </div>
            <div>
              <dt>Output</dt>
              <dd>3 free / 32 PRO</dd>
            </div>
            <div>
              <dt>Access</dt>
              <dd>Lite + PRO</dd>
            </div>
          </dl>
          <div class="product-actions tools-feature-actions">
            <a class="button primary" href="/preset-mutator/">
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              Open Preset Mutator Lite
            </a>
            <a class="button secondary" href="/tools/preset-mutator/">
              <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
              Product Details
            </a>
            <a class="button secondary" href="https://kreativ.gumroad.com/l/preset-mutator" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
              Get PRO for €19
            </a>
          </div>
        </div>
        <a class="tools-feature-media" href="/preset-mutator/" aria-label="Open Preset Mutator Lite">
          <img src="/assets/thumbs/preset-mutator.webp" width="720" height="405" alt="Preset Mutator Lite cover artwork" loading="eager" decoding="async" />
        </a>
      </section>

      <section class="tools-feature-card" aria-labelledby="wave-mutator-title">
        <div class="tools-feature-copy">
          <p class="product-kicker tools-kicker-row">
            <span>Beta browser tool</span>
            <span class="tools-beta-sticker">BETA</span>
          </p>
          <h2 id="wave-mutator-title" class="page-title">Wave Mutator Lite</h2>
          <p class="page-lead">Local audio cleanup for sound designers and sample-pack makers.</p>
          <p class="product-summary">Drop in messy WAV files, trim silence, fade, normalize, inspect warnings, export clean single files or ZIP packs, and create preview montages without uploading audio.</p>
          <dl class="tools-feature-meta" aria-label="Wave Mutator Lite facts">
            <div>
              <dt>Format</dt>
              <dd>Browser tool</dd>
            </div>
            <div>
              <dt>Input</dt>
              <dd>WAV files</dd>
            </div>
            <div>
              <dt>Export</dt>
              <dd>WAV + ZIP</dd>
            </div>
            <div>
              <dt>Privacy</dt>
              <dd>Local only</dd>
            </div>
          </dl>
          <div class="product-actions tools-feature-actions">
            <a class="button primary" href="/tools/wave-mutator/">
              <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
              Open Wave Mutator Lite
            </a>
          </div>
        </div>
        <a class="tools-feature-media" href="/tools/wave-mutator/" aria-label="Open Wave Mutator Lite">
          <img src="/assets/thumbs/wave-mutator.jpg" width="1440" height="810" alt="Wave Mutator Lite cover artwork showing waveform cleanup and sample export" loading="lazy" decoding="async" />
        </a>
      </section>

      <section class="tools-feature-card pattern-mutator-tool-card" aria-labelledby="pattern-mutator-title">
        <div class="tools-feature-copy">
          <p class="product-kicker tools-kicker-row">
            <span>First draft</span>
            <span class="tools-beta-sticker">PROTOTYPE</span>
          </p>
          <h2 id="pattern-mutator-title" class="page-title">Pattern Mutator Lite</h2>
          <p class="page-lead">Generate a MIDI pattern, lock the parts you like, and mutate the rest.</p>
          <p class="product-summary">Start scale-aware melodies, basslines, chords, and arpeggios from scratch. Set an exact 1–32 bar length, audition locally, and export a Standard MIDI file for your DAW.</p>
          <dl class="tools-feature-meta" aria-label="Pattern Mutator Lite facts">
            <div>
              <dt>Format</dt>
              <dd>Browser tool</dd>
            </div>
            <div>
              <dt>Output</dt>
              <dd>Editable MIDI</dd>
            </div>
            <div>
              <dt>Length</dt>
              <dd>1–32 bars</dd>
            </div>
            <div>
              <dt>Privacy</dt>
              <dd>Local only</dd>
            </div>
          </dl>
          <div class="product-actions tools-feature-actions">
            <a class="button primary" href="/tools/pattern-mutator/">
              <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
              Open Pattern Mutator Lite
            </a>
          </div>
        </div>
        <a class="tools-feature-media pattern-mutator-tool-preview" href="/tools/pattern-mutator/" aria-label="Open Pattern Mutator Lite">
          <span class="pattern-preview-name">PM</span>
          <span class="pattern-preview-grid" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
          <span class="pattern-preview-caption">GENERATE · LOCK · MUTATE</span>
        </a>
      </section>
    </div>
  </section>
  <style>
    .pattern-mutator-tool-preview {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 310px;
      overflow: hidden;
      color: #fff4eb;
      background: radial-gradient(circle at 76% 24%, rgba(213, 92, 219, .65), transparent 24%), radial-gradient(circle at 18% 86%, rgba(239, 107, 69, .72), transparent 31%), #201d27;
    }
    .pattern-preview-name { position: relative; z-index: 1; font-size: clamp(4rem, 10vw, 7.5rem); font-weight: 900; letter-spacing: -.1em; }
    .pattern-preview-grid { position: absolute; inset: 20% 13%; display: grid; grid-template-columns: repeat(8, 1fr); align-items: end; gap: 4%; opacity: .86; }
    .pattern-preview-grid::before { content: ""; position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; background: repeating-linear-gradient(to bottom, transparent 0, transparent 12%, rgba(255,255,255,.1) 12.5%); }
    .pattern-preview-grid i { position: relative; z-index: 1; display: block; border-radius: 4px 4px 2px 2px; background: linear-gradient(#ffb27a, #ed6a46); box-shadow: 0 5px 13px rgba(0,0,0,.18); }
    .pattern-preview-grid i:nth-child(1) { height: 29%; }.pattern-preview-grid i:nth-child(2) { height: 51%; }.pattern-preview-grid i:nth-child(3) { height: 38%; }.pattern-preview-grid i:nth-child(4) { height: 69%; }.pattern-preview-grid i:nth-child(5) { height: 42%; }.pattern-preview-grid i:nth-child(6) { height: 78%; }.pattern-preview-grid i:nth-child(7) { height: 59%; }.pattern-preview-grid i:nth-child(8) { height: 33%; }
    .pattern-preview-caption { position: absolute; right: 1.2rem; bottom: 1rem; font-size: .62rem; font-weight: 800; letter-spacing: .13em; }
  </style>
</BaseLayout>
