---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteUpdates, type SiteUpdateKind } from "../../lib/site-updates";
import { displayToolReleaseVersion, toolReleases } from "../../lib/tool-releases";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.published || "").localeCompare(a.data.published || ""));
const guidePosts = posts.filter((post) => post.data.section === "learn");
const releasePosts = posts.filter((post) => post.data.section === "news" && post.data.kind === "release");
const customerUpdates = siteUpdates.filter((item) => item.audience !== "maintenance");
const maintenanceUpdates = siteUpdates.filter((item) => item.audience === "maintenance");
const featuredUpdate = customerUpdates[0];
const latestUpdates = customerUpdates.slice(1, 10);
const archivedUpdates = customerUpdates.slice(10);
const presetMutatorFree = toolReleases.presetMutatorFree;
const presetMutatorPro = toolReleases.presetMutatorPro;
const waveMutator = toolReleases.waveMutator;

const kindLabels: Record<SiteUpdateKind, string> = {
  new: "New",
  release: "Release",
  update: "Update",
  fix: "Fix"
};

const kindIcons: Record<SiteUpdateKind, string> = {
  new: "fa-sparkles",
  release: "fa-compact-disc",
  update: "fa-wrench",
  fix: "fa-shield-halved"
};

const counts = customerUpdates.reduce<Record<SiteUpdateKind, number>>(
  (total, item) => ({ ...total, [item.kind]: total[item.kind] + 1 }),
  { new: 0, release: 0, update: 0, fix: 0 }
);

function formatDate(date: string) {
  return new Date(`${date}T12:00:00`).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric"
  });
}

function hrefFor(post: (typeof posts)[number]) {
  return `/posts/${post.id.replace(/\.md$/, "")}.html`;
}

function imageFor(post: (typeof posts)[number]) {
  return new URL(post.data.ogImage || "https://kreativsound.com/og-image.svg").pathname;
}
---
<BaseLayout
  title="Updates & Changelog | Kreativ Sound"
  description="Kreativ Sound updates and public changelog: releases, fixes, catalog and tool changes, plus practical sound-design guides."
  canonical="https://kreativsound.com/updates/"
  activeNav="updates"
  ogImage="https://kreativsound.com/assets/thumbs/juno-nocturnes.webp"
>
  <section class="card page-main updates-page">
    <header class="updates-hero">
      <div>
        <p class="eyebrow">Kreativ Sound Updates and Changelog</p>
        <h1 class="page-title">Changes, releases, and practical guides.</h1>
        <p class="page-lead">New sound packs, browser tools, and practical workflows—kept focused on what you can use in a session.</p>
        <div class="updates-quick-stats" aria-label="Updates categories">
          <a href="#recent-log"><strong>{counts.new}</strong><span>New additions</span></a>
          <a href="#recent-log"><strong>{counts.release}</strong><span>Releases</span></a>
          <a href="#recent-log"><strong>{counts.update}</strong><span>Updates</span></a>
          <a href="#guides"><strong>{guidePosts.length}</strong><span>Guides</span></a>
        </div>
      </div>
      <aside class="updates-direction" aria-label="Updates page scope">
        <p class="product-section-kicker">Useful first</p>
        <h2>What changed, then how to use it.</h2>
        <p>Use the log for current products and tools, release notes for context, and guides for practical decisions around the catalog.</p>
        <a href="#releases">Browse release notes <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
      </aside>
    </header>

    {featuredUpdate ? <section class="updates-highlights" aria-labelledby="updates-highlights-title">
      <div class="updates-section-head">
        <p class="product-section-kicker">Latest update</p>
        <h2 id="updates-highlights-title">Start with what changed most recently.</h2>
      </div>
      <div class="updates-highlight-list">
        <a class="updates-highlight" href={featuredUpdate.href}>
          <span class="updates-highlight-meta">
            <i class:list={["fa-solid", kindIcons[featuredUpdate.kind]]} aria-hidden="true"></i>
            <span>{kindLabels[featuredUpdate.kind]}</span>
            <time datetime={featuredUpdate.date}>{formatDate(featuredUpdate.date)}</time>
          </span>
          <strong>{featuredUpdate.title}</strong>
          <span>{featuredUpdate.description}</span>
        </a>
      </div>
    </section> : null}

    <section class="updates-log" id="recent-log" aria-labelledby="updates-log-title">
      <div class="updates-section-head">
        <p class="product-section-kicker">Current catalog and tools</p>
        <h2 id="updates-log-title">What you can use now.</h2>
        <p>Product, tool, and catalog changes stay concise and newest first. Site-maintenance history is kept separately below.</p>
      </div>
      <ul class="updates-log-list">
        {latestUpdates.map((item) => (
          <li>
            <a class="updates-log-entry" href={item.href}>
              <time datetime={item.date}>{formatDate(item.date)}</time>
              <span class:list={["updates-log-kind", `is-${item.kind}`]}>{kindLabels[item.kind]}</span>
              <span class="updates-log-copy">
                <strong>{item.title}</strong>
                <span>{item.description}</span>
              </span>
              <i class="fa-solid fa-arrow-up-right-from-square updates-log-arrow" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
      <details class="news-archive updates-archive" open>
        <summary>
          <span>
            <strong>Earlier updates</strong>
            <small>{archivedUpdates.length} previous additions, releases, updates, and fixes</small>
          </span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </summary>
        <ul class="updates-log-list">
          {archivedUpdates.map((item) => (
            <li>
              <a class="updates-log-entry" href={item.href}>
                <time datetime={item.date}>{formatDate(item.date)}</time>
                <span class:list={["updates-log-kind", `is-${item.kind}`]}>{kindLabels[item.kind]}</span>
                <span class="updates-log-copy">
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square updates-log-arrow" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </section>

    {maintenanceUpdates.length ? <details class="news-archive updates-archive updates-maintenance" id="site-maintenance">
      <summary>
        <span>
          <strong>Site-maintenance history</strong>
          <small>{maintenanceUpdates.length} reliability, analytics, and publishing notes</small>
        </span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </summary>
      <ul class="updates-log-list">
        {maintenanceUpdates.map((item) => (
          <li>
            <a class="updates-log-entry" href={item.href}>
              <time datetime={item.date}>{formatDate(item.date)}</time>
              <span class:list={["updates-log-kind", `is-${item.kind}`]}>{kindLabels[item.kind]}</span>
              <span class="updates-log-copy">
                <strong>{item.title}</strong>
                <span>{item.description}</span>
              </span>
              <i class="fa-solid fa-arrow-up-right-from-square updates-log-arrow" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </details> : null}

    <div class="news-sections updates-editorial">
      <section class="news-panel" id="releases" aria-labelledby="release-notes-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Release notes</p>
          <h2 id="release-notes-title">The story behind recent releases.</h2>
          <p>Launch context, catalog direction, and the details behind current sound packs and free drops.</p>
        </div>
        <ul class="news-card-list" id="release-notes-list" data-content-list>
          {releasePosts.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img class="news-card-art" src={imageFor(post)} alt={`${post.data.title} artwork`} width="96" height="96" loading="lazy" decoding="async" />
                <span class="news-card-copy">
                  <time datetime={post.data.published}>{formatDate(post.data.published)}</time>
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read release note <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="button secondary content-list-toggle" type="button" data-content-toggle aria-controls="release-notes-list" aria-expanded="false" hidden>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          <span>Show more release notes</span>
        </button>
      </section>

      <section class="news-panel" id="guides" aria-labelledby="practical-guides-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Guides</p>
          <h2 id="practical-guides-title">Practical sound-design guides.</h2>
          <p>Direct workflows tied to current products, synths, and production decisions.</p>
        </div>
        <ul class="news-card-list" id="guide-list" data-content-list>
          {guidePosts.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img class="news-card-art" src={imageFor(post)} alt={`${post.data.title} artwork`} width="96" height="96" loading="lazy" decoding="async" />
                <span class="news-card-copy">
                  {post.data.published ? <time datetime={post.data.published}>{formatDate(post.data.published)}</time> : null}
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="button secondary content-list-toggle" type="button" data-content-toggle aria-controls="guide-list" aria-expanded="false" hidden>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          <span>Show more guides</span>
        </button>
      </section>
    </div>

    <section class="updates-tools" id="tools" aria-labelledby="tools-updates-title">
      <div class="updates-section-head">
        <p class="product-section-kicker">Tools &amp; plugins</p>
        <h2 id="tools-updates-title">The current browser-tool line, clearly scoped.</h2>
        <p>Start with a quick free workflow, move to Pro when you need a larger batch, and follow this section for the plugin releases now in development.</p>
      </div>
      <div class="updates-tool-grid">
        <article class="updates-tool-card">
          <div class="updates-tool-card-head">
            <span class="updates-tool-version">{displayToolReleaseVersion(presetMutatorFree)}</span>
            <span class="updates-tool-status">{presetMutatorFree.status}</span>
          </div>
          <h3>{presetMutatorFree.name}</h3>
          <p>Create three Vital variants from an intent, an existing preset, or a short audio source. Processing stays local and no account is required.</p>
          <ul>
            <li>3 variants per run</li>
            <li>Individual <code>.vital</code> downloads</li>
            <li>Scratch, Preset, and Audio modes</li>
          </ul>
          <a href="/preset-mutator/">Open free tool <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        <article class="updates-tool-card is-pro">
          <div class="updates-tool-card-head">
            <span class="updates-tool-version">{displayToolReleaseVersion(presetMutatorPro)}</span>
            <span class="updates-tool-status">{presetMutatorPro.status}</span>
          </div>
          <h3>{presetMutatorPro.name}</h3>
          <p>Build a larger Vital pack from the same three workflows. Pro access is a one-time purchase activated with a local browser token.</p>
          <ul>
            <li>32 variants per run</li>
            <li>Full pack ZIP export</li>
            <li>Local browser workflow</li>
          </ul>
          <a href="https://kreativ.gumroad.com/l/preset-mutator" target="_blank" rel="noopener noreferrer">Get Pro for €19 <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
        </article>
        <article class="updates-tool-card">
          <div class="updates-tool-card-head">
            <span class="updates-tool-version">{displayToolReleaseVersion(waveMutator)}</span>
            <span class="updates-tool-status">{waveMutator.status}</span>
          </div>
          <h3>{waveMutator.name}</h3>
          <p>Prepare WAV files locally with cleanup, delivery profiles, pack export, and preview-montage tools for sound-design and sample-pack workflows.</p>
          <ul>
            <li>Four delivery profiles</li>
            <li>Single-file and ZIP export</li>
            <li>MP3 preview montages</li>
          </ul>
          <a href="/tools/wave-mutator/">Open Wave Mutator Lite <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        <article class="updates-tool-card">
          <div class="updates-tool-card-head">
            <span class="updates-tool-version">In development</span>
            <span class="updates-tool-status">Plugins</span>
          </div>
          <h3>Plugins</h3>
          <p>Instrument and effect releases are in development. Format details, demos, and release notes will be added when each product is ready.</p>
          <ul>
            <li>No release dates announced</li>
            <li>Product details will appear here</li>
            <li>Updates will record each launch</li>
          </ul>
          <a href="/plugins/">View plugin status <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
      </div>
    </section>
  </section>
</BaseLayout>
