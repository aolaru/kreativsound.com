---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import UpdateLogEntry from "../../components/UpdateLogEntry.astro";
import UpdateArticleCard from "../../components/UpdateArticleCard.astro";
import { siteUpdates, type SiteUpdate } from "../../lib/site-updates";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.published || "").localeCompare(a.data.published || ""));
const guides = posts.filter((post) => post.data.section === "learn");
const ordered = [...siteUpdates].sort((a, b) => b.date.localeCompare(a.date));
const launches = ordered.filter((item) => item.audience !== "maintenance" && ["new", "release"].includes(item.kind));
const productUpdates = ordered.filter((item) => item.audience !== "maintenance" && ["update", "fix"].includes(item.kind));
const maintenance = ordered.filter((item) => item.audience === "maintenance");
const linkedArticles = new Set(ordered.map((item) => item.releaseNote));
const archivedArticles = posts.filter((post) => post.data.section === "news" && !linkedArticles.has(`/posts/${post.id.replace(/\.md$/, "")}.html`));

function groupByMonth(items: SiteUpdate[]) {
  const groups = new Map<string, SiteUpdate[]>();
  for (const item of items) {
    const key = item.date.slice(0, 7);
    groups.set(key, [...(groups.get(key) || []), item]);
  }
  return Array.from(groups, ([key, items]) => ({
    key, items,
    label: new Date(`${key}-01T12:00:00`).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  }));
}
const months = groupByMonth(productUpdates);
---
<BaseLayout title="Updates & Changelog | Kreativ Sound"
  description="New Kreativ Sound releases, product updates grouped by month, and practical guides."
  canonical="https://kreativsound.com/updates/" activeNav="updates"
  ogImage="https://kreativsound.com/assets/thumbs/juno-nocturnes.webp">
  <section class="card page-main updates-page">
    <header class="updates-hero">
      <p class="eyebrow">Kreativ Sound Updates and Changelog</p>
      <h1 class="page-title">New releases, updates, and practical guides.</h1>
      <p class="page-lead">Find a new release, check what changed, or follow a short workflow.</p>
      <nav class="updates-jump-links" aria-label="Updates categories">
        <a href="#new-releases">New releases</a><a href="#product-updates">Monthly updates</a><a href="#guides">Guides</a>
      </nav>
    </header>

    <section class="updates-log" id="new-releases" aria-labelledby="new-releases-title">
      <span id="releases" aria-hidden="true"></span>
      <div class="updates-section-head">
        <h2 id="new-releases-title">New releases</h2>
        <p>The latest six launches and catalog additions.</p>
      </div>
      <ul class="updates-log-list" data-latest-launches>
        {launches.slice(0, 6).map((item) => <li><UpdateLogEntry item={item} /></li>)}
      </ul>
      {launches.length > 6 && <details class="news-archive updates-archive">
        <summary><span><strong>Earlier launches</strong><small>{launches.length - 6} entries</small></span><span class="disclosure-arrow" aria-hidden="true">⌄</span></summary>
        <ul class="updates-log-list">{launches.slice(6).map((item) => <li><UpdateLogEntry item={item} /></li>)}</ul>
      </details>}
    </section>

    <section class="updates-log" id="product-updates" aria-labelledby="product-updates-title">
      <div class="updates-section-head">
        <h2 id="product-updates-title">Monthly product updates</h2>
        <p>Version releases, improvements, and fixes. Open a month to see its history.</p>
      </div>
      <div class="updates-month-list">
        {months.map((month, index) => <details class="updates-month-group" data-update-month={month.key} open={index === 0}>
          <summary class="updates-month-heading"><h3>{month.label}</h3><span>{month.items.length} {month.items.length === 1 ? "update" : "updates"} <span class="disclosure-arrow" aria-hidden="true">⌄</span></span></summary>
          <ul class="updates-log-list">{month.items.map((item) => <li><UpdateLogEntry item={item} /></li>)}</ul>
        </details>)}
      </div>
    </section>

    <section class="updates-log" id="guides" aria-labelledby="practical-guides-title">
      <div class="updates-section-head"><h2 id="practical-guides-title">Practical sound-design guides</h2><p>Each guide lists what you need and what you will make.</p></div>
      <ul class="news-card-list">{guides.slice(0, 4).map((post) => <li><UpdateArticleCard post={post} /></li>)}</ul>
      {guides.length > 4 && <details class="news-archive updates-archive">
        <summary><span><strong>More guides</strong><small>{guides.length - 4} workflows</small></span><span class="disclosure-arrow" aria-hidden="true">⌄</span></summary>
        <ul class="news-card-list">{guides.slice(4).map((post) => <li><UpdateArticleCard post={post} /></li>)}</ul>
      </details>}
    </section>

    <details class="news-archive updates-archive" id="site-maintenance">
      <summary><span><strong>Website maintenance</strong><small>{maintenance.length} publishing, navigation, and reliability notes</small></span><span class="disclosure-arrow" aria-hidden="true">⌄</span></summary>
      {groupByMonth(maintenance).map((month) => <section>
        <h3>{month.label}</h3><ul class="updates-log-list">{month.items.map((item) => <li><UpdateLogEntry item={item} /></li>)}</ul>
      </section>)}
    </details>
    {archivedArticles.length > 0 && <details class="news-archive updates-archive">
      <summary><span><strong>Article archive</strong><small>Earlier release coverage and website announcements</small></span><span class="disclosure-arrow" aria-hidden="true">⌄</span></summary>
      <ul class="news-card-list">{archivedArticles.map((post) => <li><UpdateArticleCard post={post} /></li>)}</ul>
    </details>}
    <nav class="updates-jump-links updates-browse" id="tools" aria-label="Explore current products">
      <a class="button secondary" href="/tools/">Browse Tools</a><a class="button secondary" href="/plugins/">Browse Plugins</a>
    </nav>
  </section>
</BaseLayout>
<style>
  .updates-hero { display: block; }
  .updates-jump-links { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
  .updates-jump-links > a { font-weight: 700; }
  .updates-browse { padding-top: 1rem; }
  .updates-month-group { display: block; }
  .updates-month-heading { cursor: pointer; list-style: none; padding: .8rem 0; }
  .updates-month-heading::-webkit-details-marker { display: none; }
  .updates-month-heading h3 { margin: 0; }
  .disclosure-arrow { display: inline-block; font-size: 1.2rem; line-height: 1; }
  .updates-month-heading .disclosure-arrow { margin-left: .5rem; }
  details[open] > summary .disclosure-arrow { transform: rotate(180deg); }
  summary:focus-visible { outline: 2px solid var(--accent, #a90000); outline-offset: 4px; }
  #releases { scroll-margin-top: 2rem; }
</style>
