---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.published || "").localeCompare(a.data.published || ""));
const newsPosts = posts.filter((post) => post.data.section === "news");
const guidePosts = posts.filter((post) => post.data.section === "learn");
const releasePosts = newsPosts.filter((post) => post.data.kind === "release");
const sitePosts = newsPosts.filter((post) => post.data.kind === "site");

const leadRelease = releasePosts[0];
const moreReleases = releasePosts.slice(1);
const featuredGuide = guidePosts.find((post) => post.data.featured) || guidePosts[0];

function hrefFor(post) {
  return `/posts/${post.id.replace(/\.md$/, "")}.html`;
}

function formatDate(date) {
  return new Date(date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

function imageFor(post) {
  return new URL(post.data.ogImage || "https://kreativsound.com/og-image.svg").pathname;
}
---
<BaseLayout
  title="News & Guides | Kreativ Sound"
  description="Kreativ Sound release news, practical sound-design guides, and selected tool updates."
  canonical="https://kreativsound.com/news/"
  activeNav="news"
  ogImage={leadRelease?.data.ogImage || "https://kreativsound.com/assets/thumbs/juno-nocturnes.jpg"}
>
  <section class="card page-main news-page">
    <div class="news-hero">
      <div class="news-hero-copy">
        <p class="eyebrow">News</p>
        <h1 class="page-title">Releases and practical sound-design guides.</h1>
        <p class="page-lead">New sound packs, free drops, and focused workflows for putting Kreativ Sound releases to work.</p>
        <div class="news-quick-stats" aria-label="News categories">
          <a href="#releases">
            <strong>{releasePosts.length}</strong>
            <span>Release updates</span>
          </a>
          <a href="#guides">
            <strong>{guidePosts.length}</strong>
            <span>Practical guides</span>
          </a>
        </div>
      </div>

      {leadRelease ? (
        <article class="news-featured">
          <a class="news-featured-media" href={hrefFor(leadRelease)} aria-label={`Read ${leadRelease.data.title}`}>
            <img
              class="news-featured-thumb"
              src={imageFor(leadRelease)}
              alt={`${leadRelease.data.title} artwork`}
              width="320"
              height="180"
              loading="eager"
              decoding="async"
            />
          </a>
          <div class="news-featured-copy">
            <div class="news-featured-meta">
              <p class="featured-label">Latest release</p>
              <time datetime={leadRelease.data.published}>{formatDate(leadRelease.data.published)}</time>
            </div>
            <h2>{leadRelease.data.title}</h2>
            <p>{leadRelease.data.description}</p>
            <a class="button primary" href={hrefFor(leadRelease)}>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              Read release
            </a>
          </div>
        </article>
      ) : null}

      {featuredGuide ? (
        <aside class="news-current-note">
          <p class="product-section-kicker">Featured guide</p>
          <h2>{featuredGuide.data.title}</h2>
          <p>{featuredGuide.data.description}</p>
          <a href={hrefFor(featuredGuide)}>Read guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </aside>
      ) : null}
    </div>

    <div class="news-sections">
      <section class="news-panel" id="releases" aria-labelledby="release-news-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Releases</p>
          <h2 id="release-news-title">Latest Sound Releases</h2>
          <p>Recent preset packs, sample releases, and free drops.</p>
        </div>
        <ul class="news-card-list">
          {moreReleases.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img
                  class="news-card-art"
                  src={imageFor(post)}
                  alt={`${post.data.title} artwork`}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <span class="news-card-copy">
                  <time datetime={post.data.published}>{formatDate(post.data.published)}</time>
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read update <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="news-panel" id="guides" aria-labelledby="practical-guides-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Guides</p>
          <h2 id="practical-guides-title">Practical Sound-Design Guides</h2>
          <p>Direct workflows tied to current products, synths, and production decisions.</p>
        </div>
        <ul class="news-card-list">
          {guidePosts.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img
                  class="news-card-art"
                  src={imageFor(post)}
                  alt={`${post.data.title} artwork`}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <span class="news-card-copy">
                  {post.data.published ? <time datetime={post.data.published}>{formatDate(post.data.published)}</time> : null}
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {sitePosts.length ? (
        <details class="news-archive" id="site-notes">
          <summary>
            <span>
              <strong>Site and tool changelog</strong>
              <small>{sitePosts.length} operational updates</small>
            </span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </summary>
          <ul class="news-archive-list">
            {sitePosts.map((post) => (
              <li>
                <a href={hrefFor(post)}>
                  <span>{post.data.title}</span>
                  <time datetime={post.data.published}>{formatDate(post.data.published)}</time>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ) : null}
    </div>
  </section>
</BaseLayout>
