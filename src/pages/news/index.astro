---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.published || "").localeCompare(a.data.published || ""));
const newsPosts = posts.filter((post) => post.data.section === "news");
const guidePosts = posts.filter((post) => post.data.section === "learn");
const releasePosts = newsPosts.filter((post) => post.data.kind === "release");

const leadRelease = releasePosts[0];
const moreReleases = releasePosts.slice(1);
const featuredGuide = guidePosts.find((post) => post.data.featured) || guidePosts[0];
const recentHighlights = newsPosts.filter((post) => post.id !== leadRelease?.id).slice(0, 3);
const recentLogPosts = newsPosts.slice(0, 6);
const archivedLogPosts = newsPosts.slice(6);

function hrefFor(post) {
  return `/posts/${post.id.replace(/\.md$/, "")}.html`;
}

function formatDate(date) {
  return new Date(date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

function imageFor(post) {
  return new URL(post.data.ogImage || "https://kreativsound.com/og-image.svg").pathname;
}

function updateLabel(post) {
  return post.data.kind === "site" ? "Update" : "Release";
}

function updateIcon(post) {
  return post.data.kind === "site" ? "fa-wrench" : "fa-compact-disc";
}
---
<BaseLayout
  title="News & Guides | Kreativ Sound"
  description="Latest Kreativ Sound releases, catalog updates, browser-tool news, and practical sound-design guides."
  canonical="https://kreativsound.com/news/"
  activeNav="news"
  ogImage={leadRelease?.data.ogImage || "https://kreativsound.com/assets/thumbs/juno-nocturnes.jpg"}
>
  <section class="card page-main news-page">
    <div class="news-hero">
      <div class="news-hero-copy">
        <p class="eyebrow">News</p>
        <h1 class="page-title">Latest releases, updates, and sound-design guides.</h1>
        <p class="page-lead">New sound packs, free drops, catalog improvements, and focused workflows for putting Kreativ Sound releases to work.</p>
        <div class="news-quick-stats" aria-label="News categories">
          <a href="#updates">
            <strong>{newsPosts.length}</strong>
            <span>Product updates</span>
          </a>
          <a href="#releases">
            <strong>{releasePosts.length}</strong>
            <span>Release updates</span>
          </a>
          <a href="#guides">
            <strong>{guidePosts.length}</strong>
            <span>Practical guides</span>
          </a>
        </div>
      </div>

      {leadRelease ? (
        <article class="news-featured">
          <a class="news-featured-media" href={hrefFor(leadRelease)} aria-label={`Read ${leadRelease.data.title}`}>
            <img
              class="news-featured-thumb"
              src={imageFor(leadRelease)}
              alt={`${leadRelease.data.title} artwork`}
              width="320"
              height="180"
              loading="eager"
              decoding="async"
            />
          </a>
          <div class="news-featured-copy">
            <div class="news-featured-meta">
              <p class="featured-label">Latest release</p>
              <time datetime={leadRelease.data.published}>{formatDate(leadRelease.data.published)}</time>
            </div>
            <h2>{leadRelease.data.title}</h2>
            <p>{leadRelease.data.description}</p>
            <a class="button primary" href={hrefFor(leadRelease)}>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              Read release
            </a>
          </div>
        </article>
      ) : null}

      {featuredGuide ? (
        <aside class="news-current-note">
          <p class="product-section-kicker">Featured guide</p>
          <h2>{featuredGuide.data.title}</h2>
          <p>{featuredGuide.data.description}</p>
          <a href={hrefFor(featuredGuide)}>Read guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </aside>
      ) : null}
    </div>

    {recentHighlights.length ? (
      <section class="news-update-highlights" aria-labelledby="latest-updates-title">
        <div class="news-update-section-head">
          <p class="product-section-kicker">Latest updates</p>
          <h2 id="latest-updates-title">What changed most recently</h2>
        </div>
        <div class="news-update-highlight-list">
          {recentHighlights.map((post) => (
            <a class="news-update-highlight" href={hrefFor(post)}>
              <span class="news-update-highlight-meta">
                <i class:list={["fa-solid", updateIcon(post)]} aria-hidden="true"></i>
                <span>{updateLabel(post)}</span>
                <time datetime={post.data.published}>{post.data.published}</time>
              </span>
              <strong>{post.data.title}</strong>
              <span>{post.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    {recentLogPosts.length ? (
      <section class="news-recent-log" id="updates" aria-labelledby="recent-log-title">
        <div class="news-update-section-head">
          <p class="product-section-kicker">Recent log</p>
          <h2 id="recent-log-title">The newest product moves, in order.</h2>
          <p>Short release and update notes, with the full story one click away.</p>
        </div>
        <ul class="news-log-list">
          {recentLogPosts.map((post) => (
            <li>
              <a class="news-log-entry" href={hrefFor(post)}>
                <time datetime={post.data.published}>{post.data.published}</time>
                <span class:list={["news-log-kind", post.data.kind === "site" && "is-update"]}>{updateLabel(post)}</span>
                <span class="news-log-copy">
                  <strong>{post.data.title}</strong>
                  <span>{post.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {archivedLogPosts.length ? (
          <details class="news-archive news-log-archive">
            <summary>
              <span>
                <strong>Earlier updates</strong>
                <small>{archivedLogPosts.length} previous releases and site updates</small>
              </span>
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </summary>
            <ul class="news-log-list">
              {archivedLogPosts.map((post) => (
                <li>
                  <a class="news-log-entry" href={hrefFor(post)}>
                    <time datetime={post.data.published}>{post.data.published}</time>
                    <span class:list={["news-log-kind", post.data.kind === "site" && "is-update"]}>{updateLabel(post)}</span>
                    <span class="news-log-copy">
                      <strong>{post.data.title}</strong>
                      <span>{post.data.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : null}
      </section>
    ) : null}

    <div class="news-sections">
      <section class="news-panel" id="releases" aria-labelledby="release-news-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Releases</p>
          <h2 id="release-news-title">Latest Sound Releases</h2>
          <p>Recent preset packs, sample releases, and free drops.</p>
        </div>
        <ul class="news-card-list" id="release-news-list" data-content-list>
          {moreReleases.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img
                  class="news-card-art"
                  src={imageFor(post)}
                  alt={`${post.data.title} artwork`}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <span class="news-card-copy">
                  <time datetime={post.data.published}>{formatDate(post.data.published)}</time>
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read update <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="button secondary content-list-toggle" type="button" data-content-toggle aria-controls="release-news-list" aria-expanded="false" hidden>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          <span>Show more releases</span>
        </button>
      </section>

      <section class="news-panel" id="guides" aria-labelledby="practical-guides-title">
        <div class="news-panel-head">
          <p class="product-section-kicker">Guides</p>
          <h2 id="practical-guides-title">Practical Sound-Design Guides</h2>
          <p>Direct workflows tied to current products, synths, and production decisions.</p>
        </div>
        <ul class="news-card-list" id="guide-news-list" data-content-list>
          {guidePosts.map((post) => (
            <li>
              <a class="news-card news-card-release" href={hrefFor(post)}>
                <img
                  class="news-card-art"
                  src={imageFor(post)}
                  alt={`${post.data.title} artwork`}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <span class="news-card-copy">
                  {post.data.published ? <time datetime={post.data.published}>{formatDate(post.data.published)}</time> : null}
                  <span class="news-card-title">{post.data.title}</span>
                  <span class="news-card-summary">{post.data.description}</span>
                  <span class="news-card-action">Read guide <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="button secondary content-list-toggle" type="button" data-content-toggle aria-controls="guide-news-list" aria-expanded="false" hidden>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          <span>Show more guides</span>
        </button>
      </section>

    </div>
  </section>
</BaseLayout>
