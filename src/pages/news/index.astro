---
const target = "/updates/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>News moved to Updates | Kreativ Sound</title>
    <meta name="description" content="Kreativ Sound news, release notes, and practical guides now live on the Updates page." />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://kreativsound.com/updates/" />
    <script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </head>
  <body>
    <main>
      <h1>News moved to Updates</h1>
      <p>Redirecting to <a href={target}>Kreativ Sound Updates</a>.</p>
    </main>
  </body>
</html>
