---
import "../../style.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const {
  title = "Kreativ Sound",
  description = "Atmospheric sound packs, practical resources, and browser-based sound design tools in development.",
  canonical = "https://kreativsound.com/",
  ogImage = "https://kreativsound.com/og-image.svg",
  ogImageAlt = "Kreativ Sound preview card",
  ogType = "website",
  publishedTime = "",
  robots = "index,follow",
  activeNav = "home",
  bodyClass = "top-level-page",
  skipLinkTarget = "#main-content",
  skipLinkLabel = "Skip to main content",
  scripts = []
} = Astro.props;

const analyticsEnabled = import.meta.env.PUBLIC_DISABLE_ANALYTICS !== "true";
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8e9e9" />
    <meta name="robots" content={robots} />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Kreativ Sound" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {analyticsEnabled ? <script is:inline defer src="/kreativ-analytics.js?v=20260819"></script> : null}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href={skipLinkTarget}>{skipLinkLabel}</a>
    <div class="container" id="top">
      <header class="site-header">
        <SiteNav active={activeNav} />
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <section class="privacy-consent" data-privacy-consent hidden aria-labelledby="privacy-consent-title">
      <div>
        <h2 id="privacy-consent-title">Optional analytics</h2>
        <p>Help improve Kreativ Sound with Google Analytics and Cloudflare Web Analytics. The site works without them.</p>
      </div>
      <div class="privacy-consent-actions">
        <button class="button primary" type="button" data-analytics-accept>Accept analytics</button>
        <button class="button secondary" type="button" data-analytics-decline>Decline</button>
        <a href="/privacy/">Privacy details</a>
      </div>
    </section>
    <script is:inline src="/site.js?v=20260724"></script>
    {scripts.map((src) => <script is:inline src={src}></script>)}
  </body>
</html>
