---
import "../../style.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const {
  title = "Kreativ Sound",
  description = "Atmospheric sound packs, practical resources, and browser-based sound design tools in development.",
  canonical = "https://kreativsound.com/",
  ogImage = "https://kreativsound.com/og-image.svg",
  ogImageAlt = "Kreativ Sound preview card",
  ogType = "website",
  publishedTime = "",
  robots = "index,follow",
  activeNav = "home",
  bodyClass = "top-level-page",
  skipLinkTarget = "#main-content",
  skipLinkLabel = "Skip to main content",
  scripts = []
} = Astro.props;

const analyticsEnabled = import.meta.env.PUBLIC_DISABLE_ANALYTICS !== "true";
const analyticsSnippet = `
  (() => {
    const load = () => {
      if (window.__kreativAnalyticsLoaded) return;
      window.__kreativAnalyticsLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){ dataLayer.push(arguments); };
      const google = document.createElement("script");
      google.async = true;
      google.src = "https://www.googletagmanager.com/gtag/js?id=G-QRTJS1KZD9";
      document.head.appendChild(google);
      window.gtag("js", new Date());
      window.gtag("config", "G-QRTJS1KZD9");
      const cf = document.createElement("script");
      cf.defer = true;
      cf.src = "https://static.cloudflareinsights.com/beacon.min.js";
      cf.dataset.cfBeacon = '{"token":"4d2ef2573cb8456282aa65a1d9defd9d"}';
      document.head.appendChild(cf);
    };
    const schedule = () => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(load, { timeout: 2500 });
      } else {
        window.setTimeout(load, 1400);
      }
    };
    window.__loadKreativAnalytics = schedule;
    let consent = null;
    try {
      consent = localStorage.getItem("kreativ-analytics-consent");
    } catch {}
    if (!consent) {
      const cookie = document.cookie
        .split("; ")
        .find((entry) => entry.startsWith("kreativ-analytics-consent="));
      consent = cookie ? decodeURIComponent(cookie.split("=").slice(1).join("=")) : null;
    }
    if (consent === "accepted") {
      if (document.readyState === "complete") schedule();
      else window.addEventListener("load", schedule, { once: true });
    }
  })();
`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8e9e9" />
    <meta name="robots" content={robots} />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Kreativ Sound" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {analyticsEnabled ? <script is:inline set:html={analyticsSnippet}></script> : null}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href={skipLinkTarget}>{skipLinkLabel}</a>
    <div class="container" id="top">
      <header class="site-header">
        <SiteNav active={activeNav} />
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <section class="privacy-consent" data-privacy-consent hidden aria-labelledby="privacy-consent-title">
      <div>
        <h2 id="privacy-consent-title">Optional analytics</h2>
        <p>Help improve Kreativ Sound with Google Analytics and Cloudflare Web Analytics. The site works without them.</p>
      </div>
      <div class="privacy-consent-actions">
        <button class="button primary" type="button" data-analytics-accept>Accept analytics</button>
        <button class="button secondary" type="button" data-analytics-decline>Decline</button>
        <a href="/privacy/">Privacy details</a>
      </div>
    </section>
    <script is:inline src="/site.js?v=20260723"></script>
    {scripts.map((src) => <script is:inline src={src}></script>)}
  </body>
</html>
