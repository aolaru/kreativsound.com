---
const { active = "sound" } = Astro.props;

function navClass(key) {
  return key === active ? "nav-link active" : "nav-link";
}
---
<nav class="site-nav site-nav-split site-nav-home" aria-label="Primary">
  <a class="nav-brand nav-brand-left" href="/" aria-label="Kreativ Sound home" aria-current={active === "" ? "page" : undefined}>
    <img class="nav-brand-mark" src="/logo-128.svg" width="128" height="128" alt="" aria-hidden="true" />
    <span class="nav-brand-copy" aria-hidden="true">
      <span class="nav-brand-name">Kreativ</span>
      <span class="nav-brand-subname">Sound</span>
    </span>
    <span class="sr-only">Kreativ Sound</span>
  </a>
  <button
    class="nav-menu-toggle"
    id="nav-menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav-panel"
    aria-label="Open menu"
  >
    <span class="nav-menu-icon" aria-hidden="true"></span>
  </button>
  <div class="site-nav-panel" id="site-nav-panel">
    <form class="site-search" action="/search/" method="get" role="search">
      <label class="sr-only" for="site-search-input">Search Kreativ Sound</label>
      <i class="fa-solid fa-magnifying-glass site-search-icon" aria-hidden="true"></i>
      <input
        class="site-search-input"
        id="site-search-input"
        name="q"
        type="search"
        role="combobox"
        aria-controls="site-search-results"
        aria-expanded="false"
        placeholder="Search site"
        autocomplete="off"
      />
    </form>
    <div class="nav-group nav-group-right">
      <a class={navClass("sound")} href="/sounds/" aria-label="Sounds" aria-current={active === "sound" ? "page" : undefined}>Sounds</a>
      <a class={navClass("tools")} href="/tools/" aria-current={active === "tools" ? "page" : undefined}>Tools</a>
      <a class={navClass("plugins")} href="/plugins/" aria-current={active === "plugins" ? "page" : undefined}>Plugins</a>
      <a class={navClass("music")} href="/music/" aria-current={active === "music" ? "page" : undefined}>Music</a>
      <a class={navClass("updates")} href="/updates/" aria-current={active === "updates" ? "page" : undefined}>Updates</a>
      <a class={navClass("about")} href="/about/" aria-current={active === "about" ? "page" : undefined}>About</a>
      <a class={navClass("contact")} href="/contact/" aria-current={active === "contact" ? "page" : undefined}>Contact</a>
      <button class="nav-link theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch theme" data-icon="moon">
        <i class="theme-icon theme-icon-sun fa-regular fa-sun" aria-hidden="true"></i>
        <i class="theme-icon theme-icon-moon fa-regular fa-moon" aria-hidden="true"></i>
        <span class="sr-only">Toggle theme</span>
      </button>
    </div>
  </div>
</nav>
