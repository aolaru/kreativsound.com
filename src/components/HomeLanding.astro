---
import { products, type Product } from "../lib/products";

const homepageProducts = products
  .filter((product) => typeof product.featuredRank === "number")
  .sort((a, b) => (a.featuredRank || 0) - (b.featuredRank || 0));
const latestProduct = homepageProducts[0] || products.find((product) => product.status === "available" && product.category === "Presets") || products[0];
const wideFeatureProducts = homepageProducts.filter((product) => product !== latestProduct);

function shortTitle(product: Product) {
  return product.title.split(" - ")[0];
}

function productImage(product: Product) {
  return product.homeImage || product.coverImage || product.thumbnail || "/logo-128.svg";
}

function productImageSrcSet(product: Product) {
  return product.homeImageSrcSet;
}

function productKicker(product: Product) {
  if (product.category === "Bundle") return "Flagship bundle";
  if (product.category === "Tools") return "Creative tool";
  if (product.badge?.toLowerCase() === "new") return "Latest release";
  return product.category === "Presets" ? "Flagship preset bank" : product.category;
}

function primaryActionLabel(product: Product) {
  if (!product.url) return product.status === "comingSoon" ? "Coming Soon" : "Details";
  if (product.category === "Tools") return "Buy Pro";
  if (product.status === "free") return "Download Free";
  if (product.status === "archive") return "Open Archive";
  return "Buy on Gumroad";
}

function cardTitle(product: Product) {
  if (product.category === "Tools") return "Preset Mutator";
  if (product.category === "Bundle") return "Kreativ Kollection V1";
  return shortTitle(product);
}

function cardPrimaryText(product: Product) {
  if (product.category === "Tools") return "Product Details";
  if (product.category === "Bundle") return "View Bundle";
  return "View Product";
}

function extraActionLabel(product: Product) {
  if (product.appUrl) return "Open Preset Mutator";
  return product.extraAction?.label;
}

function appActionUrl(product: Product) {
  return product.appUrl || product.extraAction?.url;
}
---
<header class="home-hero" aria-labelledby="home-title">
  <p class="eyebrow">Kreativ Sound</p>
  <h1 id="home-title">Boutique sounds for darker electronic and cinematic work.</h1>
  <p class="tagline">
    Focused preset banks, sample packs, and creative tools built around atmosphere, movement, texture, and usable sound design.
  </p>
  <div class="hero-actions">
    <a class="button primary" href="#latest-featured">
      <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
      Latest Product
    </a>
    <a class="button secondary" href="/sounds/">
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
      Full Catalog
    </a>
  </div>
</header>

{latestProduct ? (
  <section class="home-latest card" id="latest-featured" aria-labelledby="latest-title">
    <div class="home-latest-copy">
      <p class="featured-label">{productKicker(latestProduct)}</p>
      <h2 id="latest-title">{cardTitle(latestProduct)}</h2>
      <p>{latestProduct.useCase}</p>
      <dl class="home-product-meta">
        <div>
          <dt>Format</dt>
          <dd>{latestProduct.format}</dd>
        </div>
        <div>
          <dt>Included</dt>
          <dd>{latestProduct.count}</dd>
        </div>
        {latestProduct.price ? (
          <div>
            <dt>Price</dt>
            <dd>{latestProduct.price}</dd>
          </div>
        ) : null}
      </dl>
      <div class="home-product-actions">
        {latestProduct.detailsUrl ? (
          <a class="button secondary" href={latestProduct.detailsUrl}>
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            {cardPrimaryText(latestProduct)}
          </a>
        ) : null}
        {latestProduct.url ? (
          <a class="button primary" data-track="begin_checkout" data-track-product={latestProduct.title} data-track-placement="home_latest" href={latestProduct.url} target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
            {primaryActionLabel(latestProduct)}
          </a>
        ) : null}
      </div>
    </div>
    <a class="home-latest-art-link" href={latestProduct.detailsUrl || latestProduct.url || "/sounds/"} aria-label={`View ${shortTitle(latestProduct)}`}>
      <img
        class="home-latest-art"
        src={productImage(latestProduct)}
        srcset={productImageSrcSet(latestProduct)}
        sizes="(max-width: 760px) 92vw, 520px"
        width="720"
        height="406"
        alt={`${shortTitle(latestProduct)} product artwork`}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>
  </section>
) : null}

{wideFeatureProducts.map((product, index) => (
  <section class="home-latest card home-feature-card" aria-labelledby={`home-feature-title-${index}`}>
    <div class="home-latest-copy">
      <p class="featured-label">{productKicker(product)}</p>
      <h2 id={`home-feature-title-${index}`}>{cardTitle(product)}</h2>
      <p>{product.useCase}</p>
      <dl class="home-product-meta">
        <div>
          <dt>Format</dt>
          <dd>{product.format}</dd>
        </div>
        <div>
          <dt>Included</dt>
          <dd>{product.count}</dd>
        </div>
        {product.price ? (
          <div>
            <dt>Price</dt>
            <dd>{product.price}</dd>
          </div>
        ) : null}
      </dl>
      <div class="home-product-actions">
        {appActionUrl(product) ? (
          <a class="button primary" href={appActionUrl(product)}>
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
            {extraActionLabel(product)}
          </a>
        ) : null}
        {product.detailsUrl ? (
          <a class="button secondary" href={product.detailsUrl}>
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            {cardPrimaryText(product)}
          </a>
        ) : null}
        {product.url ? (
          <a class={appActionUrl(product) ? "button secondary" : "button primary"} data-track="begin_checkout" data-track-product={product.title} data-track-placement="home_feature" href={product.url} target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
            {primaryActionLabel(product)}
          </a>
        ) : (
          <span class="button secondary is-disabled" aria-disabled="true">
            <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
            {primaryActionLabel(product)}
          </span>
        )}
      </div>
    </div>
    <a class="home-latest-art-link" href={product.detailsUrl || appActionUrl(product) || product.url || "/sounds/"} aria-label={`View ${cardTitle(product)}`}>
      <img
        class="home-latest-art"
        src={productImage(product)}
        srcset={productImageSrcSet(product)}
        sizes="(max-width: 760px) 92vw, 520px"
        width="720"
        height="406"
        alt={`${cardTitle(product)} product artwork`}
        loading="lazy"
        decoding="async"
      />
    </a>
  </section>
))}
