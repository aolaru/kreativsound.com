---
import ProductCatalog from "./ProductCatalog.astro";

const {
  titleId = "catalog-title",
  mode = "full",
  intro = "Presets, sample packs, free Lite banks, and older archive releases in one place.",
  showGuide = true,
  showFeatured = true,
  showHeroActions = true,
  showProof = true,
  visibleCategories,
} = Astro.props;

const isCurated = mode === "curated";
const catalogCategories = visibleCategories || (isCurated ? ["Bundle", "Tools", "Presets", "Free", "Samples"] : undefined);
---
<header class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Ambient and cinematic audio</p>
    <h1>Browse Sound</h1>
    <p class="tagline">
      Dark sound packs for tension, melody, and cinematic motion.
    </p>
  </div>
  {showHeroActions ? (
    <div class="hero-actions">
      <a class="button primary" data-track="hero_explore_click" href="/sounds/kreativ-kollection-v1">
        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
        Get Kreativ Kollection V1
      </a>
      <a class="button secondary" data-track="hero_free_click" href="#catalog-presets">
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        Browse Individual Packs
      </a>
    </div>
  ) : null}
</header>

<section class="catalog card" aria-labelledby={titleId}>
  {intro ? <p class="catalog-intro" id={titleId}>{intro}</p> : <span class="sr-only" id={titleId}>Sound catalog</span>}
  {showFeatured ? (
    <article class="featured-product" aria-label="Featured product">
      <img
        class="featured-thumb"
        src="/assets/thumbs/kreativ-kollection-v1.webp"
        width="128"
        height="128"
        alt="Kreativ Kollection V1 product artwork"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="featured-content">
        <p class="featured-label">Featured</p>
        <h2>Kreativ Kollection V1</h2>
        <p>The complete Kreativ Sound preset and sample collection.</p>
        <p class="featured-supporting">16 products with a €144 individual value. Introductory price €49 through February 19, 2027, then €69.</p>
        <p class="featured-supporting">Instant Gumroad delivery, commercial-use license, and Dark Drones 2 free for V1 owners when released.</p>
      </div>
      <div class="featured-actions">
        <a class="button secondary" href="/sounds/kreativ-kollection-v1">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          Details
        </a>
        <a class="button primary featured-cta" data-track="begin_checkout" data-track-product="kreativ-kollection-v1" data-track-placement="sounds_featured" href="https://kreativ.gumroad.com/l/kreativ-kollection-v1" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
          Buy on Gumroad
        </a>
      </div>
    </article>
  ) : null}
  <ProductCatalog
    visibleCategories={catalogCategories}
    showCategoryNav={true}
  />
  {showGuide ? (
    <details class="catalog-guide catalog-guide-collapsible">
      <summary>
        <span>
          <span class="featured-label">How to choose</span>
          <strong>Pick by texture</strong>
        </span>
        <span>Open guide</span>
      </summary>
      <div class="catalog-guide-grid">
        <a href="/sounds/black-arcology-pigments-presets">
          <strong>Dark Pigments pressure</strong>
          <span>Choose Black Arcology for industrial drones, machine tone, melodic keys, and fractured FX.</span>
        </a>
        <a href="/sounds/velvet-ruins-vital-presets">
          <strong>Dark Vital melody</strong>
          <span>Choose Velvet Ruins for spectral movement, worn melodic tone, and cinematic Vital presets.</span>
        </a>
        <a href="/sounds/neolith-softube-models-presets">
          <strong>Analog tension</strong>
          <span>Choose NEOLITH when you need Softube Models presets with low-register weight and restrained motion.</span>
        </a>
        <a href="#catalog-free">
          <strong>Test first</strong>
          <span>Use Free Packs to hear the palette before moving to a full bank.</span>
        </a>
        <a href="/updates/#guides">
          <strong>Need placement ideas?</strong>
          <span>Use Guides for quick notes on layering, tension, texture, and product-specific workflows.</span>
        </a>
        <a href="/posts/how-to-use-juno-nocturnes-and-operators-for-dark-motion-2026-09-03.html">
          <strong>Build dark motion</strong>
          <span>Layer JUNO NOCTURNES and OPERATORS when a cue needs both analog space and moving digital texture.</span>
        </a>
        <a href="/posts/how-to-choose-kreativ-sound-packs-by-session-2026-09-03.html">
          <strong>Choose by session</strong>
          <span>Start with the job—score, track, transition, or raw material—then narrow the catalog from there.</span>
        </a>
      </div>
    </details>
  ) : null}
  {showProof ? (
    <section class="catalog-proof" aria-label="Kreativ Sound proof points">
      <article>
        <span>Used in real releases</span>
        <p>Olaru releases use material from the same preset and sample archive.</p>
      </article>
      <article>
        <span>Try before buying</span>
        <p>Juno Nocturnes, Operators, Black Arcology, and Velvet Ruins all have smaller free versions.</p>
      </article>
      <article>
        <span>Independent catalog</span>
        <p>Product pages link to the active Gumroad, Patreon, and KVR listings.</p>
      </article>
    </section>
  ) : null}
  {isCurated ? (
    <div class="catalog-secondary-links" aria-label="More sound categories">
      <p>Looking for archive releases?</p>
      <div class="catalog-secondary-actions">
        <a class="button secondary" href="/sounds/#catalog-legacy">
          <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
          View Archive
        </a>
      </div>
    </div>
  ) : null}
</section>
