---
import { categoryIds, categoryLabels, preferredCategoryOrder, products } from "../lib/products";

const {
  visibleCategories = preferredCategoryOrder,
  showCategoryNav = true,
  showFilters = true
} = Astro.props;

const discoveredCategories = Array.from(new Set(products.map((product) => product.category)));
const categories = [
  ...preferredCategoryOrder.filter((category) => discoveredCategories.includes(category)),
  ...discoveredCategories.filter((category) => !preferredCategoryOrder.includes(category))
].filter((category) => visibleCategories.includes(category));
const CategoryHeading = showFilters ? "h2" : "h3";

function ctaText(category: string) {
  if (category === "Free") return "Download Free";
  if (category === "Tools") return "Get Tool";
  if (category === "Legacy") return "View Archive";
  return "Get Pack";
}

function unavailableText(product: { status?: string; badge?: string; category: string }) {
  if (product.status === "comingSoon" || product.badge?.toLowerCase().includes("coming")) return "Coming soon";
  if (product.status === "archive") return "Archive only";
  if (product.category === "Bundle") return "Coming soon";
  return "Archive only";
}

function ctaTrackingEvent(product: { status?: string }) {
  if (product.status === "free") return "generate_lead";
  if (product.status === "archive") return "select_content";
  return "begin_checkout";
}
---
<div class="product-catalog" data-product-catalog>
  {showFilters ? (
    <div class="catalog-filters" aria-label="Filter sound catalog">
      <label class="catalog-filter-search">
        <span>Find a sound</span>
        <input type="search" placeholder="Search packs, synths, or textures" autocomplete="off" data-catalog-query />
      </label>
      <div class="catalog-filter-categories" role="group" aria-label="Product type">
        <button type="button" class="is-active" aria-pressed="true" data-catalog-category="all">All</button>
        {categories.map((category) => (
          <button type="button" aria-pressed="false" data-catalog-category={category}>{categoryLabels[category]}</button>
        ))}
      </div>
      <nav class="catalog-discovery" aria-label="Browse sounds by synth or use case">
        <div class="catalog-discovery-group">
          <span>By synth</span>
          <div class="catalog-discovery-links">
            <a href="/sounds/?q=JUN-6+V#catalog-title">JUN-6 V</a>
            <a href="/sounds/?q=Pigments#catalog-title">Pigments</a>
            <a href="/sounds/?q=Vital#catalog-title">Vital</a>
            <a href="/sounds/?q=FM8#catalog-title">FM8</a>
            <a href="/sounds/?q=Softube+Models#catalog-title">Softube Models</a>
          </div>
        </div>
        <div class="catalog-discovery-group">
          <span>By sound</span>
          <div class="catalog-discovery-links">
            <a href="/sounds/?q=ambient#catalog-title">Ambient</a>
            <a href="/sounds/?q=cinematic#catalog-title">Cinematic</a>
            <a href="/sounds/?q=industrial#catalog-title">Industrial</a>
            <a href="/sounds/?q=FX#catalog-title">FX and transitions</a>
            <a href="/sounds/?category=Free#catalog-title">Free packs</a>
          </div>
        </div>
      </nav>
      <p class="catalog-filter-status" role="status" aria-live="polite" data-catalog-status></p>
    </div>
  ) : null}
  {showCategoryNav && !showFilters && categories.length ? (
    <div class="catalog-anchor-links" aria-label="Catalog sections">
      {categories.map((category) => (
        <a href={`#${categoryIds[category]}`}>{categoryLabels[category]}</a>
      ))}
    </div>
  ) : null}
  {categories.map((category, categoryIndex) => {
    const categoryItems = products.filter((product) => product.category === category);
    return (
      <section class:list={["catalog-group", category === "Legacy" && "catalog-group-legacy"]} id={categoryIds[category]} data-catalog-section={category}>
        <CategoryHeading>{categoryLabels[category]}</CategoryHeading>
        <ul class="product-grid">
          {categoryItems.map((item, itemIndex) => {
            const hasPrimaryAction = Boolean(item.url);
            const hasSecondaryAction = Boolean(item.detailsUrl || item.extraAction?.url);
            const eagerImage = categoryIndex === 0 && itemIndex < 6;
            const fetchPriority = eagerImage ? "high" : "auto";
            const searchText = [item.title, item.format, item.count, item.useCase, categoryLabels[category]].join(" ").toLowerCase();

            return (
              <li data-catalog-item data-category={category} data-search-text={searchText}>
              <div class="product-card-stack">
                <div class:list={["product-card", "product-card-static", category === "Legacy" && "product-card-legacy"]}>
                  {item.badge ? (
                    <span class:list={["product-badge", item.badge.toLowerCase() === "new" && "is-new", item.badge.toLowerCase() === "updated" && "is-updated"]}>
                      {item.badge}
                    </span>
                  ) : null}
                  {item.detailsUrl ? (
                    <a class="product-thumb-link" href={item.detailsUrl} aria-label={`View ${item.title} details`}>
                      <img
                        class="product-thumb"
                        src={item.thumbnail || "/logo-128.svg"}
                        alt={`${item.title} thumbnail`}
                        width="128"
                        height="128"
                        loading={eagerImage ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={fetchPriority}
                      />
                    </a>
                  ) : (
                    <img
                      class="product-thumb"
                      src={item.thumbnail || "/logo-128.svg"}
                      alt={`${item.title} thumbnail`}
                      width="128"
                      height="128"
                      loading={eagerImage ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={fetchPriority}
                    />
                  )}
                  <span class="product-title">{item.title}</span>
                  <span class="product-meta">{item.format} | {item.count}</span>
                  {item.price ? <span class="product-price">{item.price}</span> : null}
                  <span class="product-use">{item.useCase}</span>
                  {item.demo?.src ? <span class="product-demo-pill">Audio demo available</span> : null}
                  <div class="product-action-row">
                    {item.detailsUrl ? <a class="product-action-link" href={item.detailsUrl}>Details</a> : null}
                    {item.extraAction?.url ? <a class="product-action-link" href={item.extraAction.url}>{item.extraAction.label || "More"}</a> : null}
                    {hasPrimaryAction ? (
                      <a class="product-action-link is-primary" data-track={ctaTrackingEvent(item)} data-track-product={item.title} data-track-placement="catalog" href={item.url} target="_blank" rel="noopener noreferrer">
                        {ctaText(item.category)}
                      </a>
                    ) : !hasSecondaryAction ? (
                      <span class="product-action-link is-muted">{unavailableText(item)}</span>
                    ) : null}
                  </div>
                </div>
              </div>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
  {showFilters ? (
    <div class="catalog-progress">
      <button class="button secondary" type="button" data-catalog-more hidden>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        Show more products
      </button>
    </div>
  ) : null}
</div>
