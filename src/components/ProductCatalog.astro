---
import { categoryIds, categoryLabels, preferredCategoryOrder, products } from "../lib/products";

const {
  visibleCategories = preferredCategoryOrder,
  showCategoryNav = true
} = Astro.props;

const discoveredCategories = Array.from(new Set(products.map((product) => product.category)));
const categories = [
  ...preferredCategoryOrder.filter((category) => discoveredCategories.includes(category)),
  ...discoveredCategories.filter((category) => !preferredCategoryOrder.includes(category))
].filter((category) => visibleCategories.includes(category));
const anchorCategories = categories.filter((category) => ["Presets", "Samples", "Free", "Legacy"].includes(category));
const CategoryHeading = "h2";

function ctaText(category: string) {
  if (category === "Bundle") return "Get the bundle";
  if (category === "Free") return "Download Free";
  if (category === "Tools") return "Get Tool";
  if (category === "Legacy") return "View Archive";
  return "Get Pack";
}

function ctaTrackingEvent(product: { status?: string }) {
  if (product.status === "free") return "generate_lead";
  if (product.status === "archive") return "select_content";
  return "begin_checkout";
}
---
<div class="product-catalog">
  {showCategoryNav && anchorCategories.length ? (
    <div class="catalog-anchor-links" aria-label="Catalog sections">
      {anchorCategories.map((category) => (
        <a href={`#${categoryIds[category]}`}>{categoryLabels[category]}</a>
      ))}
    </div>
  ) : null}
  {categories.map((category, categoryIndex) => {
    const categoryItems = products.filter((product) => product.category === category);
    const isBundle = category === "Bundle";
    return (
      <section class:list={["catalog-group", category === "Legacy" && "catalog-group-legacy"]} id={categoryIds[category]}>
        <CategoryHeading>{categoryLabels[category]}</CategoryHeading>
        {category === "Free" ? <p class="catalog-group-intro">Start with a free palette, then move to a full bank when the sound fits your session.</p> : null}
        {category === "Legacy" ? <p class="catalog-group-intro">Earlier releases kept for existing users and anyone looking for the original archive.</p> : null}
        <ul class="product-grid">
          {categoryItems.map((item, itemIndex) => {
            const hasPrimaryAction = Boolean(item.url);
            const eagerImage = categoryIndex === 0 && itemIndex < 6;
            const fetchPriority = eagerImage ? "high" : "auto";

            return (
              <li>
              <div class="product-card-stack">
                <div class:list={["product-card", "product-card-static", isBundle && "product-card-bundle", category === "Legacy" && "product-card-legacy"]}>
                  {item.badge ? (
                    <span class:list={["product-badge", item.badge.toLowerCase() === "new" && "is-new", item.badge.toLowerCase() === "updated" && "is-updated"]}>
                      {item.badge}
                    </span>
                  ) : null}
                  {item.detailsUrl ? (
                    <a class="product-thumb-link" href={item.detailsUrl} aria-label={`View ${item.title} details`}>
                      <img
                        class="product-thumb"
                        src={item.thumbnail || "/logo-128.svg"}
                        alt={`${item.title} thumbnail`}
                        width="128"
                        height="128"
                        loading={eagerImage ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={fetchPriority}
                      />
                    </a>
                  ) : (
                    <img
                      class="product-thumb"
                      src={item.thumbnail || "/logo-128.svg"}
                      alt={`${item.title} thumbnail`}
                      width="128"
                      height="128"
                      loading={eagerImage ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={fetchPriority}
                    />
                  )}
                  {item.detailsUrl ? (
                    <a class="product-title product-title-link" href={item.detailsUrl}>{item.title}</a>
                  ) : (
                    <span class="product-title">{item.title}</span>
                  )}
                  <span class="product-meta">{item.format} | {item.count}</span>
                  {item.price ? <span class="product-price">{item.price}</span> : null}
                  {isBundle ? <span class="product-bundle-offer">16 products · €144 individual value</span> : null}
                  <span class="product-use">{item.useCase}</span>
                  {item.demo?.src ? (
                    <div class="product-card-demo">
                      <span class="product-card-demo-label">Listen to the demo</span>
                      <audio class="product-card-demo-player" controls preload="metadata">
                        <source src={item.demo.src} type={item.demo.type || "audio/mpeg"} />
                      </audio>
                    </div>
                  ) : null}
                  <div class="product-action-row">
                    {hasPrimaryAction ? (
                      <a class="product-action-link is-primary" data-track={ctaTrackingEvent(item)} data-track-product={item.title} data-track-placement="catalog" href={item.url} target="_blank" rel="noopener noreferrer">
                        {ctaText(item.category)}
                      </a>
                    ) : item.detailsUrl ? (
                      <a class="product-action-link" href={item.detailsUrl}>View details</a>
                    ) : (
                      <span class="product-action-link is-muted">Archive only</span>
                    )}
                  </div>
                </div>
              </div>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>
