<section class="ghostform-demo" aria-labelledby="ghostform-demo-title">
  <h2 id="ghostform-demo-title">Hear Ghostform in action</h2>
  <div class="ghostform-demo-player" data-ghostform-demo-player>
    <a
      class="ghostform-demo-preview"
      href="https://www.youtube.com/watch?v=w1Lz60S_qPA"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Play KS Ghostform demo by Mack Beats Studio (loads YouTube)"
      aria-describedby="ghostform-demo-privacy"
      data-ghostform-demo-play
    >
      <img src="/assets/thumbs/ghostform-interface.png" width="1005" height="649" alt="KS Ghostform synthesizer interface" />
      <span class="ghostform-demo-play"><span aria-hidden="true">▶</span> Play demo</span>
    </a>
  </div>
  <p class="ghostform-demo-credit">Demo by <a href="https://www.youtube.com/@MackBeatsStudio" target="_blank" rel="noopener noreferrer">Mack Beats Studio</a> · Shared with permission.</p>
  <p id="ghostform-demo-privacy" class="ghostform-demo-note">YouTube loads only when you press play. <a href="https://www.youtube.com/watch?v=w1Lz60S_qPA" target="_blank" rel="noopener noreferrer">Watch on YouTube</a>.</p>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-ghostform-demo-play]").forEach((link) => {
    link.addEventListener("click", (event) => {
      // Keep the link usable without JavaScript and preserve open-in-new-tab gestures.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const player = link.closest<HTMLDivElement>("[data-ghostform-demo-player]");
      if (!player) return;
      const iframe = document.createElement("iframe");
      iframe.src = "https://www.youtube-nocookie.com/embed/w1Lz60S_qPA?autoplay=1&rel=0";
      iframe.title = "KS Ghostform demo by Mack Beats Studio";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      event.preventDefault();
      player.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .ghostform-demo { width: min(100%, 720px); min-width: 0; margin-top: 1.6rem; text-align: left; }
  .ghostform-demo h2 { margin: 0 0 .8rem; font-size: clamp(1.2rem, 3vw, 1.6rem); color: #25181b; }
  .ghostform-demo-player { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 18px; background: #111116; }
  .ghostform-demo-preview { position: relative; display: grid; place-items: center; width: 100%; height: 100%; }
  .ghostform-demo-preview::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent, rgba(0, 0, 0, .45)); pointer-events: none; }
  .ghostform-demo-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ghostform-demo-play { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: .65rem; padding: .9rem 1.4rem; border-radius: 999px; background: #ad0000; color: #fff; font-size: 1rem; font-weight: 700; box-shadow: 0 4px 24px rgba(0, 0, 0, .4); }
  .ghostform-demo-preview:hover .ghostform-demo-play { background: #c00000; }
  .ghostform-demo-preview:focus-visible { outline: 3px solid #fff; outline-offset: -5px; }
  .ghostform-demo-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .ghostform-demo-credit, .ghostform-demo-note { margin: .65rem 0 0; color: #513337; font-size: .9rem; line-height: 1.6; }
  .ghostform-demo-note { font-size: .8rem; }
  .ghostform-demo a:not(.ghostform-demo-preview) { color: #8a0000; text-decoration: underline; }
</style>
