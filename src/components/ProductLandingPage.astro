---
import PresetMutatorDetails from "./PresetMutatorDetails.astro";
import KollectionDetails from "./KollectionDetails.astro";
import GhostformDemo from "./GhostformDemo.astro";
import ObsidianReleaseNotes from "./ObsidianReleaseNotes.astro";
import type { ProductPage } from "../lib/product-pages";
import TimedOfferText from "./TimedOfferText.astro";
import { timedOffers } from "../lib/plugin-offers.ts";

type PurchaseAction = {
  url: string;
  label: string;
  icon: string;
};

const { product } = Astro.props as { product: ProductPage };
const hasDemo = Boolean(product.demo?.src);
const productName = product.headline;
const displaySpecifications = product.price
  ? [
      { label: "Price", value: product.price },
      ...product.specifications.filter((spec) => spec.label.toLowerCase() !== "price")
    ]
  : product.specifications;
const offerUrls = [product.primaryUrl, product.purchaseAltUrl].filter((url): url is string => Boolean(url));
const purchaseActions = [
  product.primaryUrl && product.primaryLabel
    ? { url: product.primaryUrl, label: product.primaryLabel, icon: purchaseIconClass(product.primaryUrl) }
    : null,
  product.purchaseAltUrl && product.purchaseAltLabel
    ? { url: product.purchaseAltUrl, label: product.purchaseAltLabel, icon: purchaseIconClass(product.purchaseAltUrl) }
    : null
].filter(Boolean) as PurchaseAction[];
const previewAction = product.previewUrl && product.previewLabel
  ? { url: product.previewUrl, label: product.previewLabel }
  : null;
const toolActions = product.slug === "preset-mutator" && product.secondaryUrl && product.secondaryLabel
  ? [{ url: product.secondaryUrl, label: product.secondaryLabel, icon: "payment-icon payment-icon-app" }]
  : [];

function purchaseIconClass(url?: string) {
  if (url?.includes("paypal.com")) return "payment-icon payment-icon-paypal";
  if (url?.includes("gumroad.com")) return "payment-icon payment-icon-gumroad";
  return "payment-icon payment-icon-shop";
}

function actionClass(index: number) {
  return index === 0 ? "button primary" : "button secondary";
}

function isExternalUrl(url: string) {
  return /^https?:\/\//.test(url);
}

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: productName,
  description: product.description,
  image: product.ogImage,
  brand: {
    "@type": "Brand",
    name: "Kreativ Sound"
  },
  category: product.kicker,
  offers: offerUrls.length
    ? offerUrls.map((url) => ({
          "@type": "Offer",
          url,
          availability: "https://schema.org/InStock",
          ...(product.priceValidUntil ? { priceValidUntil: product.priceValidUntil } : {}),
          ...(product.priceAmount
            ? {
                price: String(product.priceAmount),
                priceCurrency: product.priceCurrency || "EUR"
              }
            : {})
        }))
    : undefined
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Kreativ Sound",
      item: "https://kreativsound.com/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: product.hubLabel,
      item: `https://kreativsound.com${product.hubUrl}`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: productName,
      item: product.canonical
    }
  ]
};
---
<script type="application/ld+json" data-timed-offer-schema={Object.hasOwn(timedOffers, product.slug) ? product.slug : undefined} set:html={JSON.stringify(productSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<article class={`card page-main product-page product-page-landing product-page-${product.variant}`}>
  <nav class="product-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    <a href={product.hubUrl}>{product.hubLabel}</a>
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    <span aria-current="page">{productName}</span>
  </nav>

  <header class="product-landing-hero">
    <p class="product-kicker">{product.kicker}</p>
    <h1 class="page-title">{productName}</h1>
    <p class="page-lead">{product.subtitle}</p>

    {purchaseActions.length || previewAction || toolActions.length ? (
      <div class="product-landing-actions" aria-label="Product actions">
        {purchaseActions.map((action, index) => (
          <a class={actionClass(index)} data-track="begin_checkout" data-track-product={product.slug} data-track-placement="product_hero" href={action.url} target="_blank" rel="noopener noreferrer">
            <span class={action.icon} aria-hidden="true"></span>
            {action.label}
          </a>
        ))}
        {previewAction ? (
          <a class="button secondary" href={previewAction.url}>
            <i class="fa-solid fa-headphones" aria-hidden="true"></i>
            {previewAction.label}
          </a>
        ) : null}
        {toolActions.map((action) => (
          <a class={purchaseActions.length ? "button secondary" : "button primary"} href={action.url}>
            <span class={action.icon} aria-hidden="true"></span>
            {action.label}
          </a>
        ))}
      </div>
    ) : null}

    {product.price ? (
      <p class="product-price-line">
        <strong><TimedOfferText productUrl={product.route} value={product.price} /></strong>{product.slug === "kreativ-kollection-v1" ? " + applicable taxes, calculated at checkout" : ""} - Instant download{product.slug === "kreativ-kollection-v1" ? " • Commercial-use license included" : ""}
      </p>
    ) : null}
    {product.shortMeta ? <p class="product-landing-meta">{product.shortMeta}</p> : null}

    {product.slug === "ghostform" ? <GhostformDemo /> : (
      <figure class="product-landing-media">
        <img class="product-landing-image" src={product.image} width="1040" height="585" alt={product.imageAlt} />
      </figure>
    )}

    {hasDemo ? (
      <section class="product-landing-demo" aria-label="Audio demo">
        <h2>{product.demo.label || "Audio demo"}</h2>
        {product.demoBlurb ? <p>{product.demoBlurb}</p> : null}
        <audio class="product-card-demo-player" controls preload="metadata">
          <source src={product.demo.src} type={product.demo.type} />
        </audio>
      </section>
    ) : null}

  </header>

  {product.longDescription.length ? (
    <section class="product-landing-section product-description-section" aria-labelledby="product-description-title">
      <h2 id="product-description-title">Description</h2>
      <div class="product-long-description">
        {product.longDescription.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  ) : null}

  {product.liteComparison ? (
    <section class="product-landing-section product-lite-comparison" aria-labelledby="product-lite-comparison-title">
      <div class="product-lite-comparison-head">
        <p class="product-section-kicker">Lite vs Full</p>
        <h2 id="product-lite-comparison-title">{product.liteComparison.title}</h2>
        <p>{product.liteComparison.intro}</p>
      </div>
      <div class="product-lite-comparison-table-wrap">
        <table class="product-lite-comparison-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">{product.liteComparison.liteLabel}</th>
              <th scope="col">{product.liteComparison.fullLabel}</th>
            </tr>
          </thead>
          <tbody>
            {product.liteComparison.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td data-label={product.liteComparison?.liteLabel}>{row.lite}</td>
                <td class="product-lite-comparison-full" data-label={product.liteComparison?.fullLabel}>{row.full}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="product-lite-upgrade">
        {product.liteComparison.note ? <p>{product.liteComparison.note}</p> : null}
        <div class="product-landing-actions">
          <a
            class="button primary"
            href={product.liteComparison.upgradeUrl}
            target={isExternalUrl(product.liteComparison.upgradeUrl) ? "_blank" : undefined}
            rel={isExternalUrl(product.liteComparison.upgradeUrl) ? "noopener noreferrer" : undefined}
          >
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            {product.liteComparison.upgradeLabel}
          </a>
          {product.liteComparison.secondaryUrl && product.liteComparison.secondaryLabel ? (
            <a
              class="button secondary"
              href={product.liteComparison.secondaryUrl}
              target={isExternalUrl(product.liteComparison.secondaryUrl) ? "_blank" : undefined}
              rel={isExternalUrl(product.liteComparison.secondaryUrl) ? "noopener noreferrer" : undefined}
            >
              <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
              {product.liteComparison.secondaryLabel}
            </a>
          ) : null}
        </div>
      </div>
    </section>
  ) : null}

  {product.slug === "preset-mutator" ? <PresetMutatorDetails /> : null}
  {product.slug === "kreativ-kollection-v1" ? <KollectionDetails /> : null}

  {product.includedGroups.length ? (
    <section class="product-landing-section product-included-section" aria-labelledby="product-included-title">
      <h2 id="product-included-title">What's Included</h2>
      <div class="product-included-groups">
        {product.includedGroups.map((group) => (
          <section class="product-included-group" aria-label={group.title}>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>
                  {item.url ? <a href={item.url}>{item.name}</a> : <strong>{item.name}</strong>}
                  <span>{item.detail}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  ) : null}

  {displaySpecifications.length ? (
    <section class="product-landing-section" aria-labelledby="product-specifications-title">
      <h2 id="product-specifications-title">Product Specifications</h2>
      <dl class="product-specification-list">
        {displaySpecifications.map((spec) => (
          <div>
            <dt>{spec.label}</dt>
            <dd>{spec.label === "Price" ? <TimedOfferText productUrl={product.route} value={spec.value} /> : spec.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  ) : null}

  {product.requirements.length ? (
    <section class="product-landing-section" aria-labelledby="product-requirements-title">
      <h2 id="product-requirements-title">Requirements</h2>
      <div class="product-requirements-copy">
        {product.requirements.map((requirement) => <p>{requirement}</p>)}
      </div>
    </section>
  ) : null}

  {product.installation ? (
    <section class="product-landing-section product-help-section" aria-labelledby="product-installation-title">
      <h2 id="product-installation-title">Installation</h2>
      <ol>
        {product.installation.steps.map((step) => <li>{step}</li>)}
      </ol>
      {product.installation.sourceUrl ? (
        <p><a href={product.installation.sourceUrl} target="_blank" rel="noopener noreferrer">{product.installation.sourceLabel || "Installation guide"}</a></p>
      ) : null}
      <p>Need help? <a href="/contact/">Contact support</a> with your product, operating system, and instrument or DAW version.</p>
    </section>
  ) : null}

  {["obsidian-serum-2-presets", "obsidian-lite-serum-2-presets"].includes(product.slug) ? (
    <ObsidianReleaseNotes lite={product.slug === "obsidian-lite-serum-2-presets"} />
  ) : null}

  {product.slug === "burnshaper" ? (
    <section class="product-landing-section product-help-section" aria-labelledby="burnshaper-release-title">
      <h2 id="burnshaper-release-title">Release notes</h2>
      <p><strong>Version 1.0.1</strong> adds interface scaling at 100%, 125%, 150%, and 175%. Choose a size using the percentage control beside the About button; the selection is remembered independently of presets and projects.</p>
      <p>All sizes are available. Larger sizes may extend beyond your screen, so choose a smaller size if needed. This readability update does not change the sound, presets, or existing projects.</p>
      <p>See the <a href="/posts/burnshaper-release-2026-10-10.html">original launch announcement</a> for historical launch details. Current downloads and included release information are available on <a href="https://kreativ.gumroad.com/l/ks-burnshaper" target="_blank" rel="noopener noreferrer">Gumroad</a>.</p>
    </section>
  ) : null}

  {product.slug === "ghostform" ? (
    <section class="product-landing-section product-help-section" aria-labelledby="ghostform-release-title">
      <h2 id="ghostform-release-title">Release notes</h2>
      <p><strong>Version 1.0.1</strong> — November 9, 2026. Includes the updated Ghostform User Manual v1.0.1 (PDF).</p>
      <ul>
        <li>Improved quiet factory-preset outliers and quicker entrances in the original mood bank; Pad and Pluck envelope timings are preserved.</li>
        <li>Smoother voice stealing when all eight voices are in use.</li>
        <li>Interface zoom from 100% to 200%, Fit mode, and Cmd/Ctrl+0 size reset.</li>
        <li>Fixes for Variation Undo, preset-name persistence, keyboard loading, typed parameter units, and invalid preset data.</li>
        <li>More robust handling of unexpectedly large audio blocks.</li>
      </ul>
      <p><strong>Updating:</strong> back up important projects, quit your DAW, replace the installed plug-in, then restart or rescan. Existing 1.0.0 projects and user presets keep their saved values; select a factory preset again to hear its revised settings.</p>
      <p>Version 1.0.0 was the initial release on September 25, 2026. The synth still includes 144 factory presets and requires no activation.</p>
    </section>
  ) : null}

  <section class="product-landing-section product-discovery" aria-labelledby="product-discovery-title">
    <div class="product-discovery-head">
      <div>
        <p class="product-section-kicker">Keep exploring</p>
        <h2 id="product-discovery-title">{product.hubLabel === "Plugins" ? "More from Kreativ Sound" : "Related sounds"}</h2>
      </div>
      <a class="product-catalog-link" href={product.hubUrl}>
        {product.hubLabel === "Plugins" ? "View all plugins" : "View full catalog"}
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    <div class="product-related-grid">
      {product.relatedProducts.map((item) => (
        <a class="product-related-card" href={item.url}>
          <img src={item.image} alt={item.imageAlt} width="84" height="84" loading="lazy" decoding="async" />
          <span>
            <small>{item.category}</small>
            <strong>{item.title}</strong>
            <span>{item.meta}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {purchaseActions.length || product.finalCtaTitle || product.finalCtaText ? (
    <section class="product-final-cta" aria-labelledby="product-final-cta-title">
      <h2 id="product-final-cta-title">{product.finalCtaTitle || `Ready to download ${productName}?`}</h2>
      <p>{product.slug === "burnshaper" ? (
        <TimedOfferText productUrl={product.route} kind="note" suffix=" 30-day refunds for purchases from October 13, 2026, 00:00 Europe/Bucharest. Earlier buyers keep lifetime refunds." />
      ) : product.slug === "kreativ-kollection-v1" ? (
        <TimedOfferText productUrl={product.route} kind="note" prefix="Get the €144 collection. " suffix=" Applicable taxes are added and calculated at checkout." />
      ) : (product.finalCtaText || product.ctaLine || product.description)}</p>
      {purchaseActions.length || previewAction || toolActions.length ? (
        <div class="product-landing-actions">
          {purchaseActions.map((action, index) => (
            <a class={actionClass(index)} data-track="begin_checkout" data-track-product={product.slug} data-track-placement="product_footer" href={action.url} target="_blank" rel="noopener noreferrer">
              <span class={action.icon} aria-hidden="true"></span>
              {action.label}
            </a>
          ))}
          {previewAction ? (
            <a class="button secondary" href={previewAction.url}>
              <i class="fa-solid fa-headphones" aria-hidden="true"></i>
              {previewAction.label}
            </a>
          ) : null}
          {toolActions.map((action) => (
            <a class={purchaseActions.length ? "button secondary" : "button primary"} href={action.url}>
              <span class={action.icon} aria-hidden="true"></span>
              {action.label}
            </a>
          ))}
        </div>
      ) : null}
    </section>
  ) : null}
</article>

<style>
  .product-help-section {
    color: #513337;
    font-size: 1.02rem;
    line-height: 1.78;
    overflow-wrap: anywhere;
  }

  .product-help-section :is(ul, ol) {
    padding-left: 1.5rem;
    margin: 0.85rem 0;
  }

  .product-help-section li + li {
    margin-top: 0.6rem;
  }

  .product-help-section p + p {
    margin-top: 0.85rem;
  }
</style>
